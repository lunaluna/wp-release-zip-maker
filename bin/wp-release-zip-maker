#!/usr/bin/env bash
#
# wp-release-zip-maker
#
# テーマ・プラグイン・WordPress の外のディレクトリの配布用 Zip を、ローカルで・版を管理しながら作る.
# Zip の作成は WP-CLI の `wp dist-archive` に任せ、このツールは git と版の管理を担う薄いラッパー.
#
# 動作環境: macOS 標準の bash 3.2 でも動く書き方にする(連想配列・mapfile・${var,,} などを使わない).
# bash 3.2 では、空の配列を "${arr[@]}" と展開すると set -u で落ちる. 配列は添字のループで読む.
#
# SPDX-License-Identifier: GPL-2.0-or-later

set -u

# ツール自身の版. リリースのタグ(素の版番号)・CHANGELOG・README と必ずそろえる.
WP_RELEASE_ZIP_MAKER_VERSION="1.3.0"

# 自分の名前(--help などの表示用). シンボリックリンク経由で呼ばれても同じ名前を出す.
PROG="wp-release-zip-maker"

# 設定ファイルの名前.
CONFIG_NAME=".wp-release"

# 終了コード: 0 = 成功 / 1 = 事前の確認などで止めた(利用者が直せるもの) / 2 = 使い方の誤り・未実装.
EXIT_STOP=1
EXIT_USAGE=2

# 使う WP-CLI. 既定は PATH 上の wp. 複数の wp がある・テストで差し替えるときは環境変数で指す.
WP_BIN="${WP_RELEASE_ZIP_MAKER_WP:-wp}"

# --- 設定の読み込み結果(load_config が埋める) -------------------------------------------------
# 対象(plugin / theme / dir)は、同じ添字の 3 本の配列で持つ.
T_KIND=()  # plugin | theme | dir
T_PATH=()  # 設定ファイルからの相対パス
T_SLUG=()  # スラッグ(Zip の一番上のフォルダー名・タグ名に使う)
# check 行は、同じ添字の 2 本の配列で持つ.
C_PATH=()  # 設定ファイルからの相対パス
C_REGEX=() # その行を探す正規表現
CONFIG_FILE=""  # 見つけた設定ファイルの絶対パス
CONFIG_DIR=""   # その置き場所(相対パスの基準)
GIT_TOP=""      # Git のルート(シンボリックリンクを解いた絶対パス)
CFG_TAG_FORMAT=""
CFG_OUTPUT=""
CFG_REQUIRES=""
# 大きさの上限(省略可. 空 = 確かめない). 値はバイト数・ファイル数の整数(K・M・G は読み込み時に掛けて整数にする).
CFG_MAX_ZIP_BYTES=""          # Zip のファイルの大きさ
CFG_MAX_FILES=""              # Zip の中のファイルの数(ディレクトリは数えない)
CFG_MAX_UNCOMPRESSED_BYTES="" # 展開したときの合計の大きさ

# --- 表示まわり ---------------------------------------------------------------------------------

# 標準エラーへメッセージを出す.
err() {
	printf '%s\n' "$*" >&2
}

# 利用者が直せる理由で止めるとき. メッセージを出して終了コード 1 で終わる.
die() {
	err "${PROG}: $*"
	exit "${EXIT_STOP}"
}

# 使い方を標準出力へ出す(--help). 仕様の正は README.md.
usage() {
	cat <<EOF
${PROG} ${WP_RELEASE_ZIP_MAKER_VERSION}

配布用 Zip を作り、版のタグを打つ(push はしない).
Zip の作成は WP-CLI の 'wp dist-archive' に任せる.

使い方:
  ${PROG} <slug>
      HEAD の内容から Zip を作り、注釈付きタグを打つ(push はしない)
  ${PROG} <slug> --sign
      署名付きのタグ(git tag -s)を打つ. gpg と鍵が要る. 署名できなければ、タグも Zip も作らない
  ${PROG} <slug> --yes
      main / master 以外のブランチ(detached HEAD も)から作るときの確認(y/n/main)を飛ばして、そのまま作る.
      端末から答えられないとき(パイプ・スクリプト)は、確認が出せないので、これが要る. --rebuild・--list とは使えない
  ${PROG} <slug> --dry-run
      確認だけ(Zip もタグも作らない)
  ${PROG} <slug> [--rebuild [<版>]] --dry-run --verify-content
      確認のあと、一時ディレクトリに Zip を作り、本番と同じ中身の確認(検査・大きさの上限・名前の警告)をして、
      サマリーを出して Zip を消す. 出力先・タグ・マニフェストには何も作らない. --dry-run のときだけ指定できる
  ${PROG} <slug> [--rebuild [<版>]] --json <パス>
      成功したあと、機械が読める JSON のレポート(版・タグ・コミット・Zip の大きさと SHA-256・内容の指紋など)を、
      <パス>(カレントからの相対でもよい)に作る. 上書きしない. --dry-run・--list とは使えない
  ${PROG} <slug> [--rebuild [<版>]] --manifest
      Zip のファイルごとの SHA-256 の一覧(<slug>.<版>.manifest.txt)も、出力先に作る
  ${PROG} <slug> --rebuild [<版>]
      既存のタグの時点から Zip だけを作り直す(タグは打たない). 版を省くと HEAD の版.
      --dry-run と組み合わせられる. 作り直した Zip の内容の指紋がタグの記録と違うと、
      終了コード 1 で止める(Zip は消す)
  ${PROG} <slug> --rebuild [<版>] --allow-content-change
      内容の指紋がタグの記録と違っても、警告だけで続ける(--rebuild のときだけ指定できる)
  ${PROG} --list
      設定にある対象と、今の版・タグの有無を一覧にする
  ${PROG} --version
      ツールの版を表示する
  ${PROG} --help
      この説明を表示する

設定ファイル ${CONFIG_NAME} は、カレントディレクトリから上へ探す(Git のルートで止める).
詳しくは README.md を参照.
EOF
}

# --version の出力.
print_version() {
	printf '%s %s\n' "${PROG}" "${WP_RELEASE_ZIP_MAKER_VERSION}"
}

# --- 文字列・版の小さな道具 ---------------------------------------------------------------------

# 前後の空白を取る. 引数の文字列を標準出力へ出す.
trim() {
	local s="$1"
	s="${s#"${s%%[![:space:]]*}"}"
	s="${s%"${s##*[![:space:]]}"}"
	printf '%s' "${s}"
}

# 「X.Y.Z」の 3 つ組の版を比べて、$1 が $2 以上なら 0 を返す. どちらも数字 3 つ組であること(呼ぶ前に確かめる).
version_ge() {
	local a1 a2 a3 b1 b2 b3
	IFS=. read -r a1 a2 a3 <<<"$1"
	IFS=. read -r b1 b2 b3 <<<"$2"
	# 先頭に 0 がある数字を 8 進数と読まないよう、10# を付けて 10 進数で比べる.
	[ "$((10#${a1}))" -ne "$((10#${b1}))" ] && { [ "$((10#${a1}))" -gt "$((10#${b1}))" ]; return; }
	[ "$((10#${a2}))" -ne "$((10#${b2}))" ] && { [ "$((10#${a2}))" -gt "$((10#${b2}))" ]; return; }
	[ "$((10#${a3}))" -ge "$((10#${b3}))" ]
}

# スラッグとして使える文字だけか(英数字・ドット・ハイフン・アンダースコア. 空と先頭のドットは不可).
valid_slug() {
	case "$1" in
		'' | .* | *[!A-Za-z0-9._-]*) return 1 ;;
	esac
	return 0
}

# 設定ファイルの中のパスとして使えるか(相対パス・'..' を含まない. '.' だけは設定ファイルのある場所を指す).
valid_rel_path() {
	case "$1" in
		'' | /* | .. | ../* | */.. | */../*) return 1 ;;
	esac
	return 0
}

# 相対パスの表記ゆれをそろえる(先頭の './' と末尾の '/' を取る. 空になったら '.'). valid_rel_path を通ったものだけ渡す.
clean_rel_path() {
	local p="$1"
	while :; do
		case "${p}" in
			./*) p="${p#./}" ;;
			*/) p="${p%/}" ;;
			*) break ;;
		esac
	done
	printf '%s' "${p:-.}"
}

# $1 のパスが、対象のディレクトリ $2 の下(または同じ)か. $2 が '.' なら、すべてが下にある.
# どちらも設定ファイルからの相対パス(検証済みで、先頭の './' や末尾の '/' は無い前提).
path_under() {
	[ "$2" = "." ] && return 0
	case "$1" in
		"$2" | "$2"/*) return 0 ;;
	esac
	return 1
}

# 絶対パスを字面だけで整える('.' と '..' を畳む). 存在を問わず、シンボリックリンクも解かない.
normalize_path() {
	local IFS=/ seg result=""
	set -f
	for seg in $1; do
		case "${seg}" in
			'' | .) ;;
			..) result="${result%/*}" ;;
			*) result="${result}/${seg}" ;;
		esac
	done
	set +f
	printf '%s' "${result:-/}"
}

# 出力先の絶対パスを標準出力へ出す(設定ファイルからの相対パス・絶対パスのどちらも可).
output_dir() {
	case "${CFG_OUTPUT}" in
		/*) normalize_path "${CFG_OUTPUT}" ;;
		*) normalize_path "${CONFIG_DIR}/${CFG_OUTPUT}" ;;
	esac
}

# --- 設定ファイル -------------------------------------------------------------------------------

# 設定ファイルを探す. カレントから上へ、Git のルート(含む)まで. 見つけたら CONFIG_FILE / CONFIG_DIR を埋める.
find_config() {
	local top dir
	top="$(git rev-parse --show-toplevel 2>/dev/null)" ||
		die "Git リポジトリの中で実行してください(カレントは Git の管理下ではありません)."
	# 比べやすいよう、シンボリックリンクを解いた絶対パスにそろえる.
	top="$(cd "${top}" && pwd -P)"
	GIT_TOP="${top}"
	dir="$(pwd -P)"
	while :; do
		if [ -f "${dir}/${CONFIG_NAME}" ]; then
			CONFIG_FILE="${dir}/${CONFIG_NAME}"
			CONFIG_DIR="${dir}"
			return 0
		fi
		# Git のルートまで探して無ければ、そこで止める.
		if [ "${dir}" = "${top}" ] || [ "${dir}" = "/" ]; then
			break
		fi
		dir="$(dirname "${dir}")"
	done
	die "設定ファイル ${CONFIG_NAME} が見つかりません(Git のルート ${top} まで探しました). examples/${CONFIG_NAME} を参考に作ってください."
}

# 設定ファイルを読み、グローバルの T_* / C_* / CFG_* を埋める. 形式の誤りはすべて行番号つきで止める.
# 形式(jq に頼らず bash で読める行の形式):
#   key = value               key は tag_format / output / requires
#   <plugin|theme|dir> <パス> [スラッグ]
#   check <パス>:<正規表現>
# '#' で始まる行と、空白の後ろの '#' 以降はコメント(check の正規表現に ' #' を含められない).
load_config() {
	find_config

	local line lineno=0 first rest value kind path slug extra
	local seen_tag_format=0 seen_output=0 seen_requires=0 seen_limits=' '

	while IFS= read -r line || [ -n "${line}" ]; do
		lineno=$((lineno + 1))
		# Windows の改行(CR)を落とし、コメントと前後の空白を取る.
		line="${line%$'\r'}"
		line="${line%%[[:space:]]#*}"
		line="$(trim "${line}")"
		case "${line}" in
			'' | '#'*) continue ;;
		esac

		# 1 語目で行の種類を決める('=' の直前でも区切る: 'output=..' も読めるように).
		first="${line%%[[:space:]=]*}"
		rest="$(trim "${line#"${first}"}")"

		case "${first}" in
			tag_format | output | requires | max_zip_bytes | max_files | max_uncompressed_bytes)
				case "${rest}" in
					=*) value="$(trim "${rest#=}")" ;;
					*) die "${CONFIG_NAME}:${lineno}: '${first} = 値' の形で書いてください." ;;
				esac
				[ -n "${value}" ] || die "${CONFIG_NAME}:${lineno}: ${first} の値が空です."
				case "${first}" in
					tag_format)
						[ "${seen_tag_format}" -eq 0 ] || die "${CONFIG_NAME}:${lineno}: tag_format が 2 回書かれています."
						seen_tag_format=1
						CFG_TAG_FORMAT="${value}"
						;;
					output)
						[ "${seen_output}" -eq 0 ] || die "${CONFIG_NAME}:${lineno}: output が 2 回書かれています."
						seen_output=1
						CFG_OUTPUT="${value}"
						;;
					requires)
						[ "${seen_requires}" -eq 0 ] || die "${CONFIG_NAME}:${lineno}: requires が 2 回書かれています."
						seen_requires=1
						CFG_REQUIRES="${value}"
						;;
					max_zip_bytes | max_files | max_uncompressed_bytes)
						case "${seen_limits}" in
							*" ${first} "*) die "${CONFIG_NAME}:${lineno}: ${first} が 2 回書かれています." ;;
						esac
						seen_limits="${seen_limits}${first} "
						# 大きさの上限は 1 つの設定ファイルに 1 つ(対象ごとには持たない). 値は正の整数で、末尾に K・M・G を付けてもよい.
						value="$(parse_limit "${value}")" ||
							die "${CONFIG_NAME}:${lineno}: ${first} は、正の整数で書いてください(末尾に K・M・G を付けてもよい. 例: 20M). '$(trim "${rest#=}")' は読めません."
						case "${first}" in
							max_zip_bytes) CFG_MAX_ZIP_BYTES="${value}" ;;
							max_files) CFG_MAX_FILES="${value}" ;;
							max_uncompressed_bytes) CFG_MAX_UNCOMPRESSED_BYTES="${value}" ;;
						esac
						;;
				esac
				;;
			plugin | theme | dir)
				kind="${first}"
				# 空白区切りの最大 3 語(パス・スラッグ・余り). read は globbing をしないので '*' を含んでも安全.
				read -r path slug extra <<<"${rest}"
				[ -n "${path}" ] || die "${CONFIG_NAME}:${lineno}: ${kind} のパスがありません."
				[ -z "${extra}" ] || die "${CONFIG_NAME}:${lineno}: ${kind} の行に余分な語があります('${extra}'). 書式は '${kind} <パス> [スラッグ]' です."
				valid_rel_path "${path}" ||
					die "${CONFIG_NAME}:${lineno}: パス '${path}' は、設定ファイルからの相対パスで、'..' を含まない形にしてください."
				path="$(clean_rel_path "${path}")"
				if [ -z "${slug}" ]; then
					# スラッグ省略時はディレクトリ名. '.' はディレクトリ名が決まらないので省略できない.
					[ "${path}" != "." ] ||
						die "${CONFIG_NAME}:${lineno}: パスが '.' のときはスラッグを書いてください('${kind} . my-slug')."
					slug="$(basename "${path}")"
				fi
				valid_slug "${slug}" ||
					die "${CONFIG_NAME}:${lineno}: スラッグ '${slug}' は、英数字・ドット・ハイフン・アンダースコアだけにしてください(先頭のドットは不可)."
				T_KIND[${#T_KIND[@]}]="${kind}"
				T_PATH[${#T_PATH[@]}]="${path}"
				T_SLUG[${#T_SLUG[@]}]="${slug}"
				;;
			check)
				case "${rest}" in
					*:*) ;;
					*) die "${CONFIG_NAME}:${lineno}: check は 'check <パス>:<正規表現>' の形で書いてください." ;;
				esac
				path="${rest%%:*}"
				value="${rest#*:}"
				valid_rel_path "${path}" ||
					die "${CONFIG_NAME}:${lineno}: check のパス '${path}' は、設定ファイルからの相対パスで、'..' を含まない形にしてください."
				[ -n "${value}" ] || die "${CONFIG_NAME}:${lineno}: check の正規表現が空です."
				path="$(clean_rel_path "${path}")"
				C_PATH[${#C_PATH[@]}]="${path}"
				C_REGEX[${#C_REGEX[@]}]="${value}"
				;;
			*)
				die "${CONFIG_NAME}:${lineno}: 読めない行です('${line}')."
				;;
		esac
	done <"${CONFIG_FILE}"

	validate_config
}

# 上限の値("20M"・"500"・"1G" など)を整数にして標準出力へ出す. 書けるのは正の整数と、末尾の K・M・G(1024 の倍数. 小文字も可).
# 読めなければ何も出さず 1 を返す. 桁は 12 桁まで(bash の整数の範囲に収まり、G を掛けても溢れない).
parse_limit() {
	local v="$1" num mult=1
	case "${v}" in
		*[Kk]) mult=1024; num="${v%?}" ;;
		*[Mm]) mult=1048576; num="${v%?}" ;;
		*[Gg]) mult=1073741824; num="${v%?}" ;;
		*) num="${v}" ;;
	esac
	case "${num}" in
		'' | *[!0-9]*) return 1 ;;
	esac
	[ "${#num}" -le 12 ] || return 1
	# 先頭の 0 を 8 進数と読ませない(10# を付ける).
	num=$((10#${num}))
	[ "${num}" -gt 0 ] || return 1
	printf '%s' "$((num * mult))"
}

# 読み込んだ設定の全体としての整合を確かめる(行ごとの形式は load_config で確かめ済み).
validate_config() {
	local n="${#T_KIND[@]}" i j

	[ "${n}" -gt 0 ] || die "${CONFIG_NAME}: 対象(plugin / theme / dir の行)が 1 つもありません."
	# output は必須にする: 省略時の置き場所を決めると、Git の中に Zip を作ってしまう事故につながるため.
	[ -n "${CFG_OUTPUT}" ] || die "${CONFIG_NAME}: output(Zip の出力先)を書いてください(Git と docroot の外を推奨)."

	# tag_format の省略時は、対象が 1 つなら {version}・複数なら {slug}/{version}.
	if [ -z "${CFG_TAG_FORMAT}" ]; then
		if [ "${n}" -eq 1 ]; then
			CFG_TAG_FORMAT="{version}"
		else
			CFG_TAG_FORMAT="{slug}/{version}"
		fi
	fi
	case "${CFG_TAG_FORMAT}" in
		*'{version}'*) ;;
		*) die "${CONFIG_NAME}: tag_format には {version} を含めてください('${CFG_TAG_FORMAT}')." ;;
	esac
	# 複数の対象で {slug} が無いと、別の対象のタグが衝突する.
	if [ "${n}" -gt 1 ]; then
		case "${CFG_TAG_FORMAT}" in
			*'{slug}'*) ;;
			*) die "${CONFIG_NAME}: 対象が複数あるので、tag_format には {slug} も含めてください('${CFG_TAG_FORMAT}')." ;;
		esac
	fi

	# check 行は、どれかの対象のディレクトリの下になければならない(版の確認は対象ごとに行うため.
	# どの対象にも属さない check は、書き間違いか、確認されないまま残る行になる).
	i=0
	while [ "${i}" -lt "${#C_PATH[@]}" ]; do
		j=0
		local owned=0
		while [ "${j}" -lt "${n}" ]; do
			if path_under "${C_PATH[${i}]}" "${T_PATH[${j}]}"; then
				owned=1
				break
			fi
			j=$((j + 1))
		done
		[ "${owned}" -eq 1 ] ||
			die "${CONFIG_NAME}: check '${C_PATH[${i}]}' が、どの対象のディレクトリの下にもありません."
		i=$((i + 1))
	done

	# スラッグの重複(Zip の名前・タグが衝突する).
	i=0
	while [ "${i}" -lt "${n}" ]; do
		j=$((i + 1))
		while [ "${j}" -lt "${n}" ]; do
			[ "${T_SLUG[${i}]}" != "${T_SLUG[${j}]}" ] ||
				die "${CONFIG_NAME}: スラッグ '${T_SLUG[${i}]}' が重複しています(${T_PATH[${i}]} と ${T_PATH[${j}]})."
			j=$((j + 1))
		done
		i=$((i + 1))
	done

	# requires: ツールの版が足りなければ止める.
	if [ -n "${CFG_REQUIRES}" ]; then
		# 数字 3 つをドットでつないだ形だけ(1.2 や 1.2.3.4・1.a.3 は弾く).
		printf '%s\n' "${CFG_REQUIRES}" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$' ||
			die "${CONFIG_NAME}: requires は 'X.Y.Z' の形で書いてください('${CFG_REQUIRES}')."
		version_ge "${WP_RELEASE_ZIP_MAKER_VERSION}" "${CFG_REQUIRES}" ||
			die "このツール(${WP_RELEASE_ZIP_MAKER_VERSION})は古すぎます. ${CONFIG_NAME} は ${CFG_REQUIRES} 以上を求めています. ツールを更新してください."
	fi
}

# --- 版・タグ -----------------------------------------------------------------------------------

# 種類ごとに、版をどこから読むかの説明(--list や止めるときのメッセージで使う).
version_source() {
	case "$1" in
		theme) printf '%s' "style.css の Version:" ;;
		plugin) printf '%s' "直下の *.php のうち Plugin Name: を持つファイルの Version:" ;;
		dir) printf '%s' "VERSION ファイルの 1 行目" ;;
	esac
}

# --- 版の読み取り -------------------------------------------------------------------------------
#
# 版は、読み出し元が作業ツリーでも Git の ref でも、同じ規則で読む(規則を 1 か所にして、片方だけ直す事故を防ぐ).
# 元の違いは、次の 3 つの入口(src_*)にだけ閉じ込める. 引数の形は共通で、
#   $1 = 元の種類("dir" = 作業ツリーのディレクトリ / "ref" = Git の ref の時点)
#   $2 = dir なら対象のディレクトリ(絶対パス)/ ref なら ref
#   $3 = ref のときの、Git のルートからの対象のパス(dir のときは使わない)
#   $4 = 対象のディレクトリの直下のファイル名(src_has_file・src_cat のみ)
# 使う側: --list は作業ツリー(read_version)・Zip の作成・--rebuild は ref(read_version_at・version_file_at).

# 元の直下に、その名前のファイルがあるか.
src_has_file() {
	case "$1" in
		dir) [ -f "$2/$4" ] ;;
		ref) git -C "${GIT_TOP}" cat-file -e "$2:${3:+${3}/}$4" 2>/dev/null ;;
	esac
}

# 元の直下のファイルの内容を標準出力へ出す.
src_cat() {
	case "$1" in
		dir) cat -- "$2/$4" ;;
		ref) git -C "${GIT_TOP}" cat-file blob "$2:${3:+${3}/}$4" ;;
	esac
}

# 元の直下の *.php の名前を、NUL 区切りで標準出力へ出す.
# dir はシェルの並び・ref は Git の名前順. -z: ASCII 以外のファイル名が引用符つきで出るのを避ける.
src_php_names() {
	local f
	case "$1" in
		dir)
			for f in "$2"/*.php; do
				[ -f "${f}" ] && printf '%s\0' "${f##*/}"
			done
			;;
		ref)
			while IFS= read -r -d '' f; do
				case "${f}" in
					*.php) printf '%s\0' "${f}" ;;
				esac
			done < <(git -C "${GIT_TOP}" ls-tree -z --name-only "$2:$3" 2>/dev/null)
			;;
	esac
	return 0
}

# 標準入力の先頭 $1 バイトから「Version: x」の x を 1 つ取り出す(WordPress のヘッダーと同じ読み方).
# 行頭の空白・'*'・'#'・'@' は読み飛ばす(docblock の ' * Version: 1.0' に対応).
header_version() {
	head -c "$1" | sed -n 's/^[[:space:]*#@]*Version:[[:space:]]*\([^[:space:]]*\).*$/\1/p' | head -n 1
}

# 版を読むファイルの名前(対象のディレクトリの中での名前)を標準出力へ出す. 見つからなければ何も出さず 1 を返す.
#   $1 = 種類 / $2〜$4 = 元(src_* の $1〜$3 と同じ: 元の種類・dir か ref・ref のときのパス)
version_file_in() {
	local kind="$1" name
	case "${kind}" in
		theme)
			src_has_file "$2" "$3" "$4" style.css || return 1
			printf '%s' "style.css"
			;;
		dir)
			src_has_file "$2" "$3" "$4" VERSION || return 1
			printf '%s' "VERSION"
			;;
		plugin)
			# WordPress は Plugin Name: を先頭 8KB から探す. 同じ階層の php を順に見て、最初に見つかったものを使う.
			while IFS= read -r -d '' name; do
				if src_cat "$2" "$3" "$4" "${name}" 2>/dev/null | head -c 8192 | grep -q '^[[:space:]*#@]*Plugin Name:'; then
					printf '%s' "${name}"
					return 0
				fi
			done < <(src_php_names "$2" "$3" "$4")
			return 1
			;;
	esac
}

# 版を読んで標準出力へ出す. 読めなければ何も出さず 1 を返す.
#   $1 = 種類 / $2〜$4 = 元(version_file_in と同じ)
read_version_in() {
	local kind="$1" name v=""
	name="$(version_file_in "$@")" || return 1
	case "${kind}" in
		theme) v="$(src_cat "$2" "$3" "$4" "${name}" | header_version 5000)" ;;
		plugin) v="$(src_cat "$2" "$3" "$4" "${name}" | header_version 8192)" ;;
		dir)
			v="$(src_cat "$2" "$3" "$4" "${name}" | head -n 1)"
			v="$(trim "${v}")"
			;;
	esac
	[ -n "${v}" ] || return 1
	printf '%s' "${v}"
}

# 作業ツリーの対象の版(--list 用). 読めなければ何も出さず 1 を返す.
#   $1 = 種類 / $2 = 対象のディレクトリ(絶対パス)
read_version() {
	read_version_in "$1" dir "$2" ""
}

# タグ名を作る. $1 = スラッグ / $2 = 版.
make_tag() {
	local t="${CFG_TAG_FORMAT}"
	t="${t//\{slug\}/$1}"
	t="${t//\{version\}/$2}"
	printf '%s' "${t}"
}

# タグがあるか. $1 = タグ名.
tag_exists() {
	git -C "${CONFIG_DIR}" rev-parse -q --verify "refs/tags/$1" >/dev/null 2>&1
}

# --- --list -------------------------------------------------------------------------------------

# 設定にある対象と、今の版(作業ツリーのファイル)・タグの有無を一覧にする.
cmd_list() {
	load_config

	local n="${#T_KIND[@]}" i abs ver tag tagged
	printf '設定:       %s\n' "${CONFIG_FILE}"
	printf 'タグの形式: %s\n' "${CFG_TAG_FORMAT}"
	printf '出力先:     %s\n' "$(output_dir)"
	printf '\n'
	# 列の見出しは、日本語だと桁がそろわないので英字にする.
	printf '%-7s %-28s %-10s %-34s %-6s %s\n' KIND SLUG VERSION TAG TAGGED PATH

	i=0
	while [ "${i}" -lt "${n}" ]; do
		abs="${CONFIG_DIR}/${T_PATH[${i}]}"
		if [ ! -d "${abs}" ]; then
			# ディレクトリが無い: 版もタグも決められない. 一覧には出して印を付ける.
			printf '%-7s %-28s %-10s %-34s %-6s %s\n' \
				"${T_KIND[${i}]}" "${T_SLUG[${i}]}" '?' '-' '-' "${T_PATH[${i}]} (ディレクトリがありません)"
		elif ver="$(read_version "${T_KIND[${i}]}" "${abs}")"; then
			tag="$(make_tag "${T_SLUG[${i}]}" "${ver}")"
			if tag_exists "${tag}"; then tagged="yes"; else tagged="no"; fi
			printf '%-7s %-28s %-10s %-34s %-6s %s\n' \
				"${T_KIND[${i}]}" "${T_SLUG[${i}]}" "${ver}" "${tag}" "${tagged}" "${T_PATH[${i}]}"
		else
			printf '%-7s %-28s %-10s %-34s %-6s %s\n' \
				"${T_KIND[${i}]}" "${T_SLUG[${i}]}" '?' '-' '-' \
				"${T_PATH[${i}]} (版を読めません: $(version_source "${T_KIND[${i}]}"))"
		fi
		i=$((i + 1))
	done
}

# --- 事前の確認(Zip を作る前に、止めるべき状態をすべて確かめる) -----------------------------

# 見つけた対象の添字. find_target が埋める.
TI=-1
# check の確認の結果. check_version_files が埋める(確認した行の数・食い違った数).
CHECK_TOTAL=0
CHECK_BAD=0

# 設定からスラッグの対象を探して TI に入れる. 無ければ、設定にあるスラッグを挙げて止める.
find_target() {
	local slug="$1" i=0 known=""
	while [ "${i}" -lt "${#T_SLUG[@]}" ]; do
		if [ "${T_SLUG[${i}]}" = "${slug}" ]; then
			TI="${i}"
			return 0
		fi
		known="${known} ${T_SLUG[${i}]}"
		i=$((i + 1))
	done
	die "スラッグ '${slug}' は ${CONFIG_NAME} にありません. 設定にあるスラッグ:${known}"
}

# Zip の作成に要る道具(zip・unzip コマンド・WP-CLI・wp dist-archive)があるかを確かめる. 無ければ入れ方を示して止める.
# unzip は必須: Zip の中身の検査(スラッグのフォルダー・配布してはいけないファイル・外へ出る名前)と内容の指紋に使う.
# 1.1.0 までは、無ければ警告して検査を省き、タグまで作った. 検査を省いたまま配布物ができるのを避けるため、止める(2026-10-28 のレビュー).
check_tools() {
	command -v zip >/dev/null 2>&1 ||
		die "zip コマンドが見つかりません. wp dist-archive が Zip を作るときに使います(macOS は標準. Linux は zip パッケージを入れてください)."
	command -v unzip >/dev/null 2>&1 ||
		die "unzip コマンドが見つかりません. 作った Zip の中身の検査(スラッグのフォルダー・配布してはいけないファイル・外へ出る名前)と、内容の指紋に使います(macOS は標準. Debian 系は apt install unzip)."
	command -v "${WP_BIN}" >/dev/null 2>&1 ||
		die "WP-CLI(${WP_BIN})が見つかりません. 入れ方: https://wp-cli.org/ (macOS の Homebrew: brew install wp-cli)"
	# 登録されたコマンドなら --help は 0 で終わり、未登録なら 1 で終わる(WP-CLI 2.12.0 で確認).
	# Mac の PHP 8.4 + WP-CLI 2.12.0 は Composer の Deprecated 警告を大量に出すので、出力は捨てる.
	"${WP_BIN}" dist-archive --help >/dev/null 2>&1 ||
		die "wp dist-archive が入っていません. 入れ方:
  wp package install wp-cli/dist-archive-command:3.1.0   # WP-CLI 2.12.x
  wp package install wp-cli/dist-archive-command         # WP-CLI 2.13 以上(未確認: 2.12.0 でだけ確かめた)
版の指定なしは、WP-CLI 2.12.x では失敗します(最新版が WP-CLI 3.0 以上を要求するため)."
}

# 対象のディレクトリの中の相対パスを作る. $1 = 対象のパス(設定ファイルからの相対) / $2 = その中の名前.
rel_join() {
	if [ "$1" = "." ]; then
		printf '%s' "$2"
	else
		printf '%s/%s' "$1" "$2"
	fi
}

# 作業ツリーがきれいか(未コミット・未追跡の変更が無いか). Zip は HEAD から作るので、汚れていれば止める.
check_clean_tree() {
	local status count
	status="$(git -C "${CONFIG_DIR}" status --porcelain)" || die "git status に失敗しました."
	[ -z "${status}" ] && return 0
	count="$(printf '%s\n' "${status}" | wc -l)"
	err "${PROG}: 作業ツリーに未コミット・未追跡の変更があります(Zip は HEAD から作るので、コミットしてから実行してください):"
	printf '%s\n' "${status}" | head -n 10 | sed 's/^/  /' >&2
	if [ "$((count))" -gt 10 ]; then
		err "  ...(ほかに $((count - 10)) 件)"
	fi
	exit "${EXIT_STOP}"
}

# 版の文字列がタグ名・ファイル名に使えるか(英数字で始まり、英数字・ドット・ハイフン・アンダースコア・プラスだけ).
valid_version() {
	case "$1" in
		'' | [!0-9A-Za-z]* | *[!0-9A-Za-z._+-]*) return 1 ;;
	esac
	return 0
}

# 対象 $1 に属する check 行のファイルを、ref($3)の時点の内容で開き、版 $2 が書かれているかを確かめる
# (全部確かめてから結果を返す). 食い違いは標準エラーに出す. 結果は CHECK_TOTAL / CHECK_BAD に入れる.
# 行の中に版番号があればよい. 版の前後は、英数字・ドット・ハイフン・アンダースコア・プラス以外であること
# (1.2.3 が 11.2.30 や 1.2.3-beta に当たらないように).
check_version_files() {
	local idx="$1" ver="$2" ref="$3" i=0 content re lines rc pat shown
	CHECK_TOTAL=0
	CHECK_BAD=0
	pat="(^|[^0-9A-Za-z._+-])$(printf '%s' "${ver}" | sed 's/[.+]/\\&/g')([^0-9A-Za-z._+-]|\$)"
	while [ "${i}" -lt "${#C_PATH[@]}" ]; do
		if path_under "${C_PATH[${i}]}" "${T_PATH[${idx}]}"; then
			CHECK_TOTAL=$((CHECK_TOTAL + 1))
			re="${C_REGEX[${i}]}"
			if ! blob_exists "${ref}" "${C_PATH[${i}]}"; then
				err "  ${C_PATH[${i}]}: ファイルがありません(コミット済みのものを確かめます)"
				CHECK_BAD=$((CHECK_BAD + 1))
			else
				content="$(blob_cat "${ref}" "${C_PATH[${i}]}")"
				# grep の終了コード: 0 = 一致あり / 1 = 一致なし / 2 = 正規表現の誤りなど.
				lines="$(printf '%s\n' "${content}" | grep -E -- "${re}" 2>/dev/null)"
				rc=$?
				if [ "${rc}" -ge 2 ]; then
					err "  ${C_PATH[${i}]}: 正規表現 '${re}' が不正です"
					CHECK_BAD=$((CHECK_BAD + 1))
				elif [ "${rc}" -eq 1 ]; then
					err "  ${C_PATH[${i}]}: 正規表現 '${re}' に一致する行がありません"
					CHECK_BAD=$((CHECK_BAD + 1))
				elif ! printf '%s\n' "${lines}" | grep -Eq -- "${pat}"; then
					shown="$(printf '%s\n' "${lines}" | head -n 3 | sed 's/^[[:space:]]*/      /')"
					err "  ${C_PATH[${i}]}: 版 ${ver} が書かれていません. 一致した行(最大 3 行):"
					err "${shown}"
					CHECK_BAD=$((CHECK_BAD + 1))
				fi
			fi
		fi
		i=$((i + 1))
	done
}

# --- Zip の作成 ---------------------------------------------------------------------------------

# 一時ディレクトリ(make_zip が作る). 終了時に必ず消す.
TMP_WORK=""
# make_zip が、作った Zip を 1 回だけ展開して走査した結果(zip_scan の行)を書くファイル. TMP_WORK の中にある.
# 内容の指紋(タグ・--rebuild の比較)とマニフェストは、このファイルを読む(同じ走査の結果なので食い違わず、展開も 1 回で済む).
ZIP_SCAN_FILE=""
# make_zip が作った Zip の、一時ディレクトリの中のパス(置く前の Zip. --verify-content は、これを表示して消す).
BUILT_ZIP=""
# check_rebuild_digest の結果(--json の content_match 用): 1 = 一致 / 0 = 不一致 / 空 = 記録なし・比べられない.
REBUILD_CONTENT_MATCH=""
# 起動したときの引数(main の最初に取っておく). 「main」と答えて切り替えたあと、同じ引数でツールを起動し直すのに使う.
ORIG_ARGS=()
# 内部用の環境変数: 「main」の答えで切り替えて起動し直したとき、元のブランチ名を新しいプロセスへ渡す(最後の表示と、聞き直しの防止に使う).
SWITCHED_FROM_VAR="WP_RELEASE_ZIP_MAKER_SWITCHED_FROM"
# 出力先に作りかけの一時ファイルのパス(publish_zip が作る. 終了時に cleanup_tmp が消す).
PART_FILE=""

# 一時ディレクトリを消す(trap から呼ぶ). 作っていなければ何もしない.
cleanup_tmp() {
	if [ -n "${TMP_WORK}" ] && [ -d "${TMP_WORK}" ]; then
		rm -rf -- "${TMP_WORK}"
	fi
	# 出力先に作りかけの一時ファイル(publish_zip が作る)があれば、それも消す.
	if [ -n "${PART_FILE}" ]; then
		rm -f -- "${PART_FILE}"
	fi
}

# 標準入力の SHA-256 を標準出力へ出す(macOS は shasum・Linux は sha256sum・どちらも無ければ openssl).
sha256_stdin() {
	if command -v shasum >/dev/null 2>&1; then
		shasum -a 256 | awk '{print $1}'
	elif command -v sha256sum >/dev/null 2>&1; then
		sha256sum | awk '{print $1}'
	else
		openssl dgst -sha256 -r | awk '{print $1}'
	fi
}

# ファイルの SHA-256 を標準出力へ出す.
sha256_of() {
	sha256_stdin <"$1"
}

# 標準入力の NUL 区切りのパスの各ファイルを SHA-256 にして、"<64 桁の 16 進数>  <パス>" の行を標準出力へ出す(まとめて 1 回で計算する).
# macOS は shasum・Linux は sha256sum・どちらも無ければ openssl("<ハッシュ> *<パス>" の形で出るので、呼び出し側が '*' の有無を吸収する).
sha256_files_stdin() {
	if command -v shasum >/dev/null 2>&1; then
		xargs -0 shasum -a 256 --
	elif command -v sha256sum >/dev/null 2>&1; then
		xargs -0 sha256sum --
	else
		xargs -0 openssl dgst -sha256 -r
	fi
}

# Zip の中身を一時ディレクトリへ展開し、内容を表す行を並べ替えて標準出力へ出す(内容の指紋とマニフェストの元になるデータ). 展開できない・ファイルが 1 つも無ければ、何も出さず 1 を返す.
# unzip の有無は check_tools が確かめ済み(無ければ、ここへ来る前に止まる).
#   F <内容の SHA-256> ./<パス>   通常のファイル(内容そのものを SHA-256 にする)
#   X ./<パス>                    実行権限(所有者)があるファイル
#   L ./<パス> -> <リンク先>      シンボリックリンク
# 空のディレクトリは入れない(dist-archive の経路によって空エントリが出たり出なかったりするため. ファイルがあれば、その親は暗黙に決まる).
# 展開先は TMP_WORK の下に作る(make_zip が作り、終了時に cleanup_tmp が消す. 途中で中断されても取り残さない). パスの ASCII 以外のバイトは、そのまま扱う(LC_ALL=C).
zip_scan() {
	local dir lines
	[ -n "${TMP_WORK}" ] && [ -d "${TMP_WORK}" ] || return 1
	dir="$(mktemp -d "${TMP_WORK}/digest.XXXXXX")" || return 1
	if ! unzip -qq "$1" -d "${dir}" </dev/null >/dev/null 2>&1; then
		rm -rf -- "${dir}"
		return 1
	fi
	lines="$(
		cd "${dir}" || exit 1
		{
			LC_ALL=C find . -type f -print0 | LC_ALL=C sha256_files_stdin | LC_ALL=C sed 's/^\([0-9a-f]\{64\}\)  *\*\{0,1\}/F \1 /'
			LC_ALL=C find . -type f -perm -u+x | LC_ALL=C sed 's/^/X /'
			LC_ALL=C find . -type l -exec sh -c 'for f; do printf "L %s -> %s\n" "$f" "$(readlink "$f")"; done' sh {} +
		} | LC_ALL=C sort
	)"
	rm -rf -- "${dir}"
	# F の行が 1 つも無い(= ファイルが無い)Zip は、データにしない.
	printf '%s\n' "${lines}" | grep -q '^F ' || return 1
	printf '%s\n' "${lines}"
}

# Zip の「内容の指紋」を標準出力へ出す. make_zip が作った走査の結果(ZIP_SCAN_FILE)が無ければ、何も出さず 1 を返す.
# zip_scan の行(ファイルの内容・実行権限・リンク先を含み、時刻・属性・圧縮のしかたを含まない)を SHA-256 にしたもの.
# 以前は unzip -v の CRC-32 と名前から作っていた. CRC-32 は、同じ値になる別の内容を意図的に作れるので、同じ内容かどうかの根拠にならない(2026-10-26 のレビュー).
# Zip 全体の SHA-256 は、同じコミットから作り直しても毎回変わる(zip が時刻などの属性を入れるため. 2026-10-26 に確認). 内容が同じかどうかは、この指紋で比べる.
zip_content_digest() {
	[ -n "${ZIP_SCAN_FILE}" ] && [ -s "${ZIP_SCAN_FILE}" ] || return 1
	sha256_stdin <"${ZIP_SCAN_FILE}"
}

# Zip のマニフェスト(ファイルごとの "<SHA-256>  <Zip の一番上のフォルダーからのパス>")を標準出力へ出す. 走査の結果(ZIP_SCAN_FILE)が無ければ、何も出さず 1 を返す.
# 内容の指紋と同じファイル(ZIP_SCAN_FILE の F の行)から作るので、両者は食い違わない. 形は shasum -a 256 -c が読める('  ' の 2 つの空白).
# 展開した Zip のディレクトリで `shasum -a 256 -c <マニフェスト>` を実行すれば、中身が同じかを照合できる.
# 実行権限とシンボリックリンクは載せない(内容の指紋には入っている).
zip_manifest() {
	[ -n "${ZIP_SCAN_FILE}" ] && [ -s "${ZIP_SCAN_FILE}" ] || return 1
	LC_ALL=C sed -n 's/^F \([0-9a-f]\{64\}\) \.\//\1  /p' "${ZIP_SCAN_FILE}"
}

# Zip のマニフェストを作って、出力先へ上書きせずに置き、場所とファイル数を表示する. 作れなければ(展開できない)非 0 を返す.
#   $1 = Zip のパス / $2 = マニフェストの最終のパス
write_manifest() {
	local zip_file="$1" dest="$2" tmp n
	[ -n "${TMP_WORK}" ] && [ -d "${TMP_WORK}" ] || return 1
	tmp="${TMP_WORK}/manifest.txt"
	zip_manifest >"${tmp}" || return 1
	[ -s "${tmp}" ] || return 1
	n="$(wc -l <"${tmp}")"
	n=$((n))
	publish_zip "${tmp}" "${dest}" "マニフェスト"
	printf 'マニフェスト: %s (%s ファイル. 展開した Zip のディレクトリで shasum -a 256 -c で照合できます)\n' "${dest}" "${n}"
}

# バイト数を読みやすい単位にして標準出力へ出す.
human_size() {
	awk -v b="$1" 'BEGIN {
		if (b >= 1048576) printf "%.2f MB", b / 1048576;
		else if (b >= 1024) printf "%.1f KB", b / 1024;
		else printf "%d B", b;
	}'
}

# Git の ref($3)の時点の対象ディレクトリから Zip を作る. 作業ツリーは使わない(未追跡・無視されたファイルは入らない).
#   $1 = スラッグ / $2 = 対象のパス(設定ファイルからの相対) / $3 = ref(コミットのハッシュ) / $4 = 出力する Zip のパス / $5 = 種類(plugin・theme・dir)
#   $6 = 1(既定)なら、確認のあと出力先へ置く(publish_zip). 0 なら置かない(--dry-run --verify-content). 置かないときも、確認はすべて同じに行う.
# 作った Zip(確認のあと・置く前)は BUILT_ZIP に入る. 置かなければ、その Zip は TMP_WORK の中にだけあり、終了時に消える.
# 手順: git archive で一時ディレクトリ/<スラッグ>/ へ展開 → wp dist-archive(.distignore を適用して zip) → 中身の確認.
# 一時ディレクトリの名前を実パスにするのは、シンボリックリンクを含むと dist-archive が別の経路(コピー)に入るため.
# 一時ディレクトリの下をスラッグと同じ名前にするのは、Zip の一番上のフォルダー名をスラッグにするため.
make_zip() {
	local slug="$1" path="$2" ref="$3" zip_file="$4" kind="$5" place="${6:-1}"
	local tree_path dest st wp_out wp_rc built

	# リポジトリのルートから見た対象のパス(git archive の <ref>:<パス> に使う). PREFIX は cmd_build が埋める.
	tree_path="$(tree_path_of "${path}")"

	TMP_WORK="$(mktemp -d "${TMPDIR:-/tmp}/wp-release-zip-maker.XXXXXX")" || die "一時ディレクトリを作れません."
	TMP_WORK="$(cd "${TMP_WORK}" && pwd -P)"
	trap cleanup_tmp EXIT
	trap 'exit 130' INT
	trap 'exit 143' TERM
	dest="${TMP_WORK}/${slug}"
	mkdir "${dest}"

	# git archive は、.gitattributes の export-ignore を効かせる(それに合うファイルは .distignore に書かなくても入らない).
	# Git のルートで実行する: サブディレクトリで実行すると、その階層より下だけに絞られ、<ref>:<パス> が空になるため
	# (設定ファイルが Git のルートの下の app/public などにある構成で実際に起きた).
	git -C "${GIT_TOP}" archive --format=tar "${ref}:${tree_path}" | tar -x -C "${dest}"
	st=("${PIPESTATUS[@]}")
	[ "${st[0]}" -eq 0 ] || die "git archive に失敗しました(${ref}:${tree_path})."
	[ "${st[1]}" -eq 0 ] || die "tar での展開に失敗しました."
	[ -n "$(ls -A "${dest}")" ] || die "${ref} の '${path}' にファイルがありません."

	# Zip は、まず一時ディレクトリの中に作り、確認してから最終のパス(zip_file)へ移す(publish_zip).
	# 理由: ①確認と作成の間に、別のプロセスが同じ名前のファイルを作っても、それを上書きしない. 壊れたシンボリックリンクの先へも書かない.
	#       ②wp dist-archive は、出力先のパスに ; ' " $ ( ) ` & * ? などがあると Zip を作れない(2026-10-26 に確認).
	#         安全なパスに作れば、出力先の名前の制約が無くなる. 検査に落ちた Zip も、最終のパスに現れない.
	built="${TMP_WORK}/zip/$(basename "${zip_file}")"

	# stdin を閉じるのは、万一 dist-archive が確認を求めても、待たずに落ちるようにするため.
	# 出力は、Mac の PHP 8.4 + WP-CLI 2.12.0 が出す Composer の Deprecated 警告を除いて表示する.
	wp_out="$("${WP_BIN}" dist-archive "${dest}" "${built}" --plugin-dirname="${slug}" --create-target-dir 2>&1 </dev/null)"
	wp_rc=$?
	wp_out="$(printf '%s\n' "${wp_out}" | grep -v -i '^\(PHP \)\{0,1\}Deprecated:' | grep -v '^$')"
	if [ "${wp_rc}" -ne 0 ] || [ ! -f "${built}" ]; then
		die "wp dist-archive に失敗しました(終了コード ${wp_rc}):
${wp_out}"
	fi

	verify_zip "${slug}" "${built}" "${kind}"
	warn_non_ascii_names "${dest}"
	# 大きさの上限(書いてあれば). 超えていれば、ここで止まる(出力先には何も置かない).
	check_zip_limits "${slug}" "${built}"
	# 中身の走査(展開とハッシュ)は、ここで 1 回だけ行う. 以降の指紋・マニフェストはこの結果を読む.
	# 置く前(publish_zip の前)に行うので、展開できなければ、最終のパスに Zip を残さずに止まる.
	ZIP_SCAN_FILE="${TMP_WORK}/scan.txt"
	zip_scan "${built}" >"${ZIP_SCAN_FILE}" || die "Zip を展開できず、中身を走査できませんでした(内容の指紋を作れないので、Zip は作りません)."
	BUILT_ZIP="${built}"
	[ "${place}" -eq 0 ] || publish_zip "${built}" "${zip_file}"
}

# 作ったファイル($1)を、最終のパス($2)へ、上書きせずに置く. すでに何かあれば(壊れたシンボリックリンクも)、置かずに止める.
# $3 = 表示に使う呼び名(省略すると Zip. マニフェストも同じ手順で置くため).
# $4 = 1 なら、置けなくても止めずに、メッセージを出して 1 を返す(--json のレポート用. 置けなくても、Zip とタグはできているため).
#   省略(0)なら、置けないときは die で止める(Zip・マニフェスト).
# 手順: 出力先と同じディスク上の一時ファイルへコピー → ln(ハードリンク)で最終のパスの名前を作る → 一時ファイルを消す.
#   ln は、行き先がすでにあれば必ず失敗する(確認と作成が 1 つの操作になる). 一時ファイルは出力先と同じディスクに作るので、ln が使える.
#   ハードリンクを作れないファイルシステムでは、mv -n で置く(あとで一時ファイルが残っていれば、すでにあったと判断する).
# 一時ファイルは mktemp の 0600 のままにせず、umask どおりの権限にする(以前の dist-archive の出力と同じ).
publish_zip() {
	local src="$1" dest="$2" label="${3:-Zip}" soft="${4:-0}" dir mode
	dir="$(dirname "${dest}")"
	if ! mkdir -p -- "${dir}"; then
		publish_fail "${soft}" "出力先 ${dir} を作れません." || return 1
	fi
	if ! PART_FILE="$(mktemp "${dir}/.$(basename "${dest}").XXXXXX")"; then
		PART_FILE=""
		publish_fail "${soft}" "出力先 ${dir} に一時ファイルを作れません(書き込めますか?)." || return 1
	fi
	mode="$(printf '%o' $((0666 & ~$(umask))))"
	if ! { cp -- "${src}" "${PART_FILE}" && chmod "${mode}" "${PART_FILE}"; }; then
		publish_fail "${soft}" "${label} を出力先 ${dir} へコピーできません(ディスクの空きは足りていますか?)." || return 1
	fi
	if [ -e "${dest}" ] || [ -L "${dest}" ]; then
		publish_fail "${soft}" "${label} がすでにあります(${dest}). このツールは上書きしません(作っている間に、別のプロセスが作りましたか?). 確かめて消してから実行してください." || return 1
	fi
	if ! ln -- "${PART_FILE}" "${dest}" 2>/dev/null; then
		if [ -e "${dest}" ] || [ -L "${dest}" ]; then
			publish_fail "${soft}" "${label} がすでにあります(${dest}). このツールは上書きしません(作っている間に、別のプロセスが作りましたか?). 確かめて消してから実行してください." || return 1
		fi
		# ハードリンクを作れない(ln が使えないファイルシステム). mv -n は、行き先があれば動かない.
		mv -n -- "${PART_FILE}" "${dest}" 2>/dev/null
		if [ -e "${PART_FILE}" ]; then
			publish_fail "${soft}" "${label} を ${dest} へ置けませんでした(すでにあるか、書き込めません)." || return 1
		fi
	fi
	rm -f -- "${PART_FILE}"
	PART_FILE=""
}

# publish_zip の失敗の扱い. $1 = 1 なら、メッセージを出して作りかけの一時ファイルを消し、1 を返す(呼び出し側が続ける). 0 なら die で止める(一時ファイルは終了時に消える).
publish_fail() {
	local soft="$1"
	shift
	[ "${soft}" -eq 1 ] || die "$*"
	err "${PROG}: $*"
	[ -z "${PART_FILE}" ] || rm -f -- "${PART_FILE}"
	PART_FILE=""
	return 1
}

# Zip に入るファイル名に ASCII 以外(日本語など)があれば警告する(止めはしない).
# macOS・Linux の zip は、UTF-8 の名前に「UTF-8 の名前」のフラグを付けない(2026-10-26 に macOS の zip で確認: Python の zipfile は cp437 と読んだ).
# 展開する環境(Windows の標準機能など)によっては文字化けする. WordPress のテーマ・プラグインでは避けるのが無難.
# 判定は、表示が崩れる unzip の出力ではなく、展開した一時ディレクトリ(.distignore の適用前)で行う.
#   $1 = 展開した一時ディレクトリ
warn_non_ascii_names() {
	local n
	# LC_ALL=C のとき [:print:] は ASCII の印字可能文字(空白を含む)だけ. その外 = ASCII 以外のバイトを含む名前.
	n="$(LC_ALL=C find "$1" -name '*[![:print:]]*' 2>/dev/null | wc -l)"
	n=$((n))
	if [ "${n}" -gt 0 ]; then
		err "警告: ASCII 以外の文字を含むファイル名が ${n} 個あります(.distignore で除いたものも数えています). Zip にエンコーディングの印が付かないため、展開する環境によっては文字化けします. WordPress のテーマ・プラグインでは、ファイル名を英数字にするのが無難です."
	fi
}

# 作った Zip の中身を確かめる: 全部がスラッグのフォルダーの下にあること・配布してはいけないファイルが無いこと.
#   $1 = スラッグ / $2 = Zip のパス / $3 = 種類(plugin・theme・dir)
verify_zip() {
	local slug="$1" zip_file="$2" kind="$3" found stops warns n escapes
	# スラッグに正規表現の記号(ドット)があっても安全なよう、awk の index() で前方一致を見る.
	# LC_ALL=C: ファイル名に ASCII 以外が入ると、ロケールによっては awk・sort が不正なバイト列で落ちるため.
	if ! unzip -Z1 "${zip_file}" | LC_ALL=C awk -v s="${slug}/" 'index($0, s) != 1 { bad = 1 } END { exit bad ? 1 : 0 }'; then
		rm -f -- "${zip_file}"
		die "Zip の中に、${slug}/ の外のファイルがあります(Zip は消しました). dist-archive の動作が想定と違います."
	fi

	# 'slug/../x' のように、スラッグのフォルダーの外へ出る名前(部品が '..' のもの)があれば止める.
	# 上の前方一致は 'slug/' で始まれば通すので、'slug/../evil' はすり抜ける. 展開する側(WordPress・unzip)が弾くかどうかに頼らない.
	escapes="$(unzip -Z1 "${zip_file}" | LC_ALL=C tr -c '[:print:]\n' '?' | LC_ALL=C awk -F/ '{ for (i = 1; i <= NF; i++) if ($i == "..") { print; next } }')"
	if [ -n "${escapes}" ]; then
		rm -f -- "${zip_file}"
		err "${PROG}: Zip の中に、スラッグのフォルダーの外へ出る名前(.. を含むパス)があります(Zip は消しました):"
		printf '%s\n' "${escapes}" | head -n 20 | sed 's/^/  /' >&2
		exit "${EXIT_STOP}"
	fi

	# 配布してはいけないファイル(止める)と、ドットで始まるファイル(警告). 判定は scan_zip_names の説明を参照.
	found="$(unzip -Z1 "${zip_file}" | LC_ALL=C tr -c '[:print:]\n' '?' | scan_zip_names "${kind}")"
	stops="$(printf '%s\n' "${found}" | sed -n 's/^S	//p')"
	warns="$(printf '%s\n' "${found}" | sed -n 's/^W	//p' | LC_ALL=C sort -u)"
	if [ -n "${stops}" ]; then
		rm -f -- "${zip_file}"
		n="$(printf '%s\n' "${stops}" | wc -l)"
		n=$((n))
		err "${PROG}: Zip に、配布してはいけないファイルが ${n} 個入っています(Zip は消しました):"
		printf '%s\n' "${stops}" | head -n 50 | sed 's/^/  /' >&2
		[ "${n}" -le 50 ] || err "  ... ほか $((n - 50)) 個"
		err "秘密情報(.env・wp-config.php・秘密鍵)・DB ダンプ・バックアップ・.git・このツールの設定(${CONFIG_NAME})など、配布してはいけない名前です. 例外はありません."
		err "Zip に入れないなら、対象の .distignore に書いて、コミットしてください."
		exit "${EXIT_STOP}"
	fi
	if [ -n "${warns}" ]; then
		n="$(printf '%s\n' "${warns}" | wc -l)"
		n=$((n))
		err "警告: ドットで始まるファイル・ディレクトリが入っています(${n} 件). 秘密や作業用のものでなければ、そのままで構いません. 不要なら .distignore に書いてください:"
		printf '%s\n' "${warns}" | head -n 20 | sed 's/^/  /' >&2
		[ "${n}" -le 20 ] || err "  ... ほか $((n - 20)) 件"
	fi
}

# Zip のファイル名(1 行に 1 つ・印字できないバイトは '?' にそろえてある)を標準入力から読み、問題のあるものを標準出力へ出す.
#   $1 = 種類(plugin・theme・dir)
# 出力の形: "S<タブ>パス"(止めるもの)・"W<タブ>パス"(警告するもの). 大文字小文字は区別しない(ASCII のみ).
# 止めるもの(通常のファイルだけを見る. 例外はなく、外すには .distignore に書く):
#   名前が .env・.env.*・wp-config.php・id_rsa/id_ed25519/id_ecdsa/id_dsa・.htpasswd・.npmrc・.netrc・.git-credentials・.DS_Store・設定ファイル(CONFIG_NAME)
#   拡張子が .pem・.key・.p12・.pfx(秘密鍵)・.sql・.sql.gz・.dump(DB ダンプ)・.bak・.orig・.swp・末尾が ~(バックアップ・エディターの残り)
#   パスの途中に .git・.svn のディレクトリがある
# 警告するもの: 上に当たらない、ドットで始まるファイル・ディレクトリ(一番上のスラッグのフォルダーは除く). 次は警告しない:
#   dir のときの .htaccess・.well-known(配布物そのものであることが多い). 同じディレクトリの下の複数のファイルは、そのディレクトリ 1 件にまとめる
scan_zip_names() {
	LC_ALL=C awk -v kind="$1" -v cfg="${CONFIG_NAME}" '
		function lower(s) { return tolower(s) }
		function endswith(s, t) { return length(s) >= length(t) && substr(s, length(s) - length(t) + 1) == t }
		function forbidden(b) {
			if (b == ".env" || index(b, ".env.") == 1 || b == "wp-config.php" || b == ".htpasswd" || b == ".npmrc" || b == ".netrc" || b == ".git-credentials" || b == ".ds_store") return 1
			if (b == "id_rsa" || b == "id_ed25519" || b == "id_ecdsa" || b == "id_dsa" || b == lower(cfg)) return 1
			if (endswith(b, ".pem") || endswith(b, ".key") || endswith(b, ".p12") || endswith(b, ".pfx")) return 1
			if (endswith(b, ".sql") || endswith(b, ".sql.gz") || endswith(b, ".dump")) return 1
			if (endswith(b, ".bak") || endswith(b, ".orig") || endswith(b, ".swp") || endswith(b, "~")) return 1
			return 0
		}
		{
			name = $0
			isdir = (name ~ /\/$/)
			n = split(name, parts, "/")
			split(lower(name), lp, "/")
			last = isdir ? n - 1 : n
			stop = 0
			if (!isdir) {
				if (forbidden(lp[last])) stop = 1
				for (i = 2; i < last; i++) if (lp[i] == ".git" || lp[i] == ".svn") stop = 1
			}
			if (stop) { print "S\t" name; next }
			# 警告: スラッグのフォルダー(1 つ目)の下で、最初にドットで始まる部品(免除されるものを除く)
			path = parts[1]
			for (i = 2; i <= last; i++) {
				path = path "/" parts[i]
				if (substr(lp[i], 1, 1) != ".") continue
				if (kind == "dir" && (lp[i] == ".htaccess" || lp[i] == ".well-known")) continue
				print "W\t" path
				break
			}
		}'
}

# 大きさの上限を書いているときだけ、「上限: 〜 以下」の行を出す(確かめたあとの要約に付く. 超えていれば、ここへ来る前に止まっている).
print_limits_line() {
	local parts=""
	[ -z "${CFG_MAX_ZIP_BYTES}" ] || parts="${parts:+${parts}・}Zip ${CFG_MAX_ZIP_BYTES} バイト"
	[ -z "${CFG_MAX_FILES}" ] || parts="${parts:+${parts}・}ファイル ${CFG_MAX_FILES} 個"
	[ -z "${CFG_MAX_UNCOMPRESSED_BYTES}" ] || parts="${parts:+${parts}・}展開後 ${CFG_MAX_UNCOMPRESSED_BYTES} バイト"
	[ -z "${parts}" ] || printf '上限:       %s 以下(%s の設定)\n' "${parts}" "${CONFIG_NAME}"
}

# Zip の中の、通常のファイルの数(ディレクトリのエントリは数えない). $1 = Zip のパス
zip_file_count() {
	unzip -Z1 "$1" | LC_ALL=C awk '$0 !~ /\/$/ { n++ } END { print n + 0 }'
}

# Zip を展開したときの合計のバイト数. unzip -Zt の "N bytes uncompressed" から読む. 読めなければ unzip -l の合計の行で読む. どちらも読めなければ 1 を返す.
# 書式は Info-ZIP の版で違う可能性がある(この Mac の unzip 6.00 で確かめた. 他の版は未確認).
zip_uncompressed_bytes() {
	local n
	n="$(unzip -Zt "$1" | sed -n 's/.*[^0-9]\([0-9][0-9]*\) bytes uncompressed.*/\1/p' | head -n 1)"
	if [ -z "${n}" ]; then
		n="$(unzip -l "$1" | tail -n 1 | awk '{ print $1 }')"
	fi
	case "${n}" in
		'' | *[!0-9]*) return 1 ;;
	esac
	printf '%s' "${n}"
}

# 大きさの上限を確かめる. 書いてある項目だけ確かめる(どれも書いていなければ何もしない).
# 超えたら、超えた項目と値・大きいファイルの上位 10 個(展開後の大きさ順)・直下の内訳を出して、終了コード 1 で止める.
# 呼ぶのは make_zip の中(最終のパスへ置く前)なので、止まっても出力先に Zip は残らない(一時ディレクトリの Zip は、終了時に消える).
#   $1 = スラッグ / $2 = 確かめる Zip のパス
check_zip_limits() {
	local slug="$1" zip_file="$2" bytes files unc over=""
	[ -n "${CFG_MAX_ZIP_BYTES}${CFG_MAX_FILES}${CFG_MAX_UNCOMPRESSED_BYTES}" ] || return 0
	bytes="$(wc -c <"${zip_file}")"
	bytes=$((bytes))
	files="$(zip_file_count "${zip_file}")"
	if [ -n "${CFG_MAX_UNCOMPRESSED_BYTES}" ]; then
		unc="$(zip_uncompressed_bytes "${zip_file}")" ||
			die "Zip の展開後の大きさを読めませんでした(max_uncompressed_bytes を確かめられないので、止めます)."
	fi
	if [ -n "${CFG_MAX_ZIP_BYTES}" ] && [ "${bytes}" -gt "${CFG_MAX_ZIP_BYTES}" ]; then
		over="${over}  max_zip_bytes: Zip の大きさ $(human_size "${bytes}")(${bytes} バイト)が、上限 $(human_size "${CFG_MAX_ZIP_BYTES}")(${CFG_MAX_ZIP_BYTES} バイト)を超えています"$'\n'
	fi
	if [ -n "${CFG_MAX_FILES}" ] && [ "${files}" -gt "${CFG_MAX_FILES}" ]; then
		over="${over}  max_files: ファイルの数 ${files} 個が、上限 ${CFG_MAX_FILES} 個を超えています"$'\n'
	fi
	if [ -n "${CFG_MAX_UNCOMPRESSED_BYTES}" ] && [ "${unc}" -gt "${CFG_MAX_UNCOMPRESSED_BYTES}" ]; then
		over="${over}  max_uncompressed_bytes: 展開後の合計 $(human_size "${unc}")(${unc} バイト)が、上限 $(human_size "${CFG_MAX_UNCOMPRESSED_BYTES}")(${CFG_MAX_UNCOMPRESSED_BYTES} バイト)を超えています"$'\n'
	fi
	[ -n "${over}" ] || return 0
	err "${PROG}: Zip が、${CONFIG_NAME} に書かれた大きさの上限を超えています(Zip は出力先に置きません。タグも打ちません):"
	printf '%s' "${over}" >&2
	err ""
	err "大きいファイルの上位 10 個(展開後の大きさ):"
	# unzip -Zl の 1 行: 権限 版 OS 大きさ 種類 圧縮後 方式 日付 時刻 名前(名前は 10 番目から. 空白を含みうる). ディレクトリ(末尾 /)は除く.
	unzip -Zl "${zip_file}" | LC_ALL=C awk '$1 ~ /^[-dlrwxsStT]{10}$/ && $0 !~ /\/$/ { sz = $4; sub(/^([^ ]+ +){9}/, ""); printf "%d\t%s\n", sz, $0 }' |
		LC_ALL=C tr -c '[:print:]\t\n' '?' | LC_ALL=C sort -t "$(printf '\t')" -k1,1nr | head -n 10 |
		LC_ALL=C awk -F'\t' '{ printf "  %12d バイト  %s\n", $1, $2 }' >&2
	print_top_level_breakdown "${slug}" "${zip_file}" >&2
	exit "${EXIT_STOP}"
}

# 作った Zip の要約を出す(ファイル数・サイズ・SHA-256・上限・一番上のフォルダーの直下の内訳).
#   $1 = スラッグ / $2 = Zip のパス
print_zip_summary() {
	local slug="$1" zip_file="$2" bytes
	bytes="$(wc -c <"${zip_file}")"
	bytes=$((bytes))
	printf 'Zip:        %s\n' "${zip_file}"
	printf 'サイズ:     %s (%s バイト)\n' "$(human_size "${bytes}")" "${bytes}"
	printf 'SHA-256:    %s\n' "$(sha256_of "${zip_file}")"
	printf '中身:       %s\n' "$(unzip -Zt "${zip_file}" | sed 's/^[[:space:]]*//')"
	print_limits_line
	print_top_level_breakdown "${slug}" "${zip_file}"
}

# 一番上のフォルダーの直下の内訳(ファイル数 名前)を出す. $1 = スラッグ / $2 = Zip のパス
print_top_level_breakdown() {
	local slug="$1" zip_file="$2"
	printf '\n%s/ の直下(ファイル数 名前):\n' "${slug}"
	# 一番上のフォルダーの直下の名前ごとに、ファイル数を数える(末尾が '/' のディレクトリのエントリは数えない).
	# LC_ALL=C: ASCII 以外のファイル名でも落ちないように. macOS の unzip は、ASCII 以外のバイトの一部を '?' に置き換え、
	# 残りは不正な UTF-8 のまま出す. 端末を崩さないよう、印字できないバイトを '?' にそろえてから数える.
	unzip -Z1 "${zip_file}" | LC_ALL=C tr -c '[:print:]\n' '?' | LC_ALL=C awk -F/ '$0 !~ /\/$/ && NF >= 2 && $2 != "" { c[$2]++ } END { for (k in c) printf "  %5d  %s\n", c[k], k }' | LC_ALL=C sort -k2 | head -n 40
}

# --- JSON のレポート(--json) --------------------------------------------------------------------

# 文字列($1)を JSON の文字列の中身(両端の " を除く)にして標準出力へ出す.
# 変えるもの: \ と " と制御文字(0x00〜0x1f. \n・\t・\r・\b・\f はその書き方、ほかは \u00XX). ASCII 以外のバイトは、そのまま出す(UTF-8 前提).
# 改行を含む文字列も 1 つの値として扱うため、行ごとに処理して \n でつなぐ. 末尾の改行が落ちないよう、番兵の '_' を付けて渡し、最後に外す.
json_escape() {
	printf '%s_' "$1" | LC_ALL=C awk '
		BEGIN {
			for (i = 1; i < 32; i++) m[sprintf("%c", i)] = sprintf("\\u%04x", i)
			m["\t"] = "\\t"; m["\r"] = "\\r"; m["\b"] = "\\b"; m["\f"] = "\\f"
		}
		{
			n = length($0); out = ""
			for (i = 1; i <= n; i++) {
				ch = substr($0, i, 1)
				if (ch == "\\") out = out "\\\\"
				else if (ch == "\"") out = out "\\\""
				else if (ch in m) out = out m[ch]
				else out = out ch
			}
			res = (NR > 1 ? res "\\n" : "") out
		}
		END { printf "%s", substr(res, 1, length(res) - 1) }
	'
}

# JSON の文字列の値(両端の " つき). $1 = 文字列. 空なら null にしたいときは、呼び出し側が json_str_or_null を使う.
json_str() {
	printf '"%s"' "$(json_escape "$1")"
}

# 空なら null、あれば JSON の文字列.
json_str_or_null() {
	if [ -z "$1" ]; then
		printf 'null'
	else
		json_str "$1"
	fi
}

# 今の時刻を ISO 8601(ローカル時刻 + オフセット. 例: 2026-10-28T16:30:00+09:00)で標準出力へ出す.
# date の %z は +0900 の形(コロンなし)なので、コロンを入れる.
iso_now() {
	date '+%Y-%m-%dT%H:%M:%S%z' | sed 's/\([+-][0-9][0-9]\)\([0-9][0-9]\)$/\1:\2/'
}

# レポートの JSON を作って、$1 のパスへ上書きせずに置く. 置けなければ、メッセージを出して 1 を返す(Zip とタグは、そのまま残す).
# 値は、作り終えた Zip とタグから読む(内容の指紋・ファイル数は make_zip の走査の結果と同じもの).
#   $1 = 置くパス / $2 = スラッグ / $3 = 種類 / $4 = 版 / $5 = 動作(build か rebuild) / $6 = タグ名 / $7 = コミット(フルのハッシュ)
#   $8 = ブランチ(build のときだけ. 空なら null) / $9 = Zip のパス / ${10} = マニフェストのパス(無ければ空) / ${11} = 1 なら署名付き(--sign)
#   ${12} = --rebuild の内容の比較(1 = 一致・0 = 不一致・空 = 記録なし. build では使わない)
write_json_report() {
	local dest="$1" slug="$2" kind="$3" ver="$4" action="$5" tag="$6" commit="$7" branch="$8" zip_file="$9"
	local manifest_path="${10}" sign="${11}" match="${12}" tmp bytes unc
	[ -n "${TMP_WORK}" ] && [ -d "${TMP_WORK}" ] || { err "${PROG}: 一時ディレクトリが無く、JSON を作れません."; return 1; }
	tmp="${TMP_WORK}/report.json"
	bytes="$(wc -c <"${zip_file}")"
	bytes=$((bytes))
	unc="$(zip_uncompressed_bytes "${zip_file}")" || unc=""
	{
		printf '{\n'
		printf '  "tool_version": %s,\n' "$(json_str "${WP_RELEASE_ZIP_MAKER_VERSION}")"
		printf '  "slug": %s,\n' "$(json_str "${slug}")"
		printf '  "kind": %s,\n' "$(json_str "${kind}")"
		printf '  "version": %s,\n' "$(json_str "${ver}")"
		printf '  "action": %s,\n' "$(json_str "${action}")"
		printf '  "tag": %s,\n' "$(json_str "${tag}")"
		printf '  "commit": %s,\n' "$(json_str "${commit}")"
		printf '  "branch": %s,\n' "$(json_str_or_null "${branch}")"
		printf '  "zip": %s,\n' "$(json_str "${zip_file}")"
		printf '  "bytes": %s,\n' "${bytes}"
		printf '  "sha256": %s,\n' "$(json_str "$(sha256_of "${zip_file}")")"
		printf '  "content_sha256": %s,\n' "$(json_str_or_null "$(zip_content_digest)")"
		printf '  "files": %s,\n' "$(zip_file_count "${zip_file}")"
		printf '  "uncompressed_bytes": %s,\n' "${unc:-null}"
		printf '  "manifest": %s,\n' "$(json_str_or_null "${manifest_path}")"
		printf '  "signed": %s,\n' "$([ "${sign}" -eq 1 ] && echo true || echo false)"
		printf '  "built_with": {\n'
		printf '    "wp_cli": %s,\n' "$(json_str "$(wp_cli_version)")"
		printf '    "dist_archive": %s,\n' "$(json_str "$(dist_archive_version)")"
		printf '    "zip": %s\n' "$(json_str "$(zip_version)")"
		printf '  },\n'
		if [ "${action}" = rebuild ]; then
			case "${match}" in
				1) printf '  "content_match": true,\n' ;;
				0) printf '  "content_match": false,\n' ;;
				*) printf '  "content_match": null,\n' ;;
			esac
		fi
		printf '  "created_at": %s\n' "$(json_str "$(iso_now)")"
		printf '}\n'
	} >"${tmp}" || { err "${PROG}: JSON を一時ファイルへ書けませんでした."; return 1; }
	publish_zip "${tmp}" "${dest}" "JSON のレポート" 1 || return 1
	printf 'JSON:       %s\n' "${dest}"
}

# --- タグ ---------------------------------------------------------------------------------------

# タグのメッセージの、見出し($2)の行の残り全部(空白は前後を取る)を標準出力へ出す. 無ければ何も出さない. $1 = タグ名.
# tag_recorded_field は 16 進数だけを読む(ハッシュ用)ので、版のような文字列にはこちらを使う.
tag_recorded_text() {
	git -C "${GIT_TOP}" tag -l --format='%(contents)' "$1" | sed -n "s/^$2:[[:space:]]*\\(.*[^[:space:]]\\)[[:space:]]*\$/\\1/p" | head -n 1
}

# --- Zip を作った道具の版 ----------------------------------------------------------------------
#
# タグに記録して、--rebuild で内容が違ったときに、道具の版が変わったのかをたどれるようにする.
# 調べられなければ 'unknown'(記録のために Zip の作成を止めはしない). どれも標準出力へ版だけを出す.
# 取り方は、この Mac での実測による(2026-10-26): wp --version = 'WP-CLI 2.12.0'・
#   wp package list --fields=name,version --format=csv の行 = 'wp-cli/dist-archive-command,v3.1.0'・zip -v の 2 行目 = 'This is Zip 3.0 (...)'.
#   dist-archive は、2026-10-28 から先に installed.json を読む(dist_archive_version の説明).
# Composer の Deprecated 警告(Mac の PHP 8.4 + WP-CLI 2.12.0)は、取り除く. stdin を閉じるのは、万一待たれても止まらないようにするため.

wp_cli_version() {
	local v
	v="$("${WP_BIN}" --version 2>/dev/null </dev/null | grep -v -i 'deprecated' | sed -n 's/^WP-CLI[[:space:]]*//p' | head -n 1 | tr -d '\r')"
	printf '%s' "${v:-unknown}"
}

# Composer の installed.json($1)から、パッケージ($2)の "version" の値を標準出力へ出す. 見つからなければ何も出さない.
# jq に頼らず、Composer が書く整形された形(1 行に 1 つのキー. "name" の直後に "version")を前提に、行で読む.
# Composer 2 の {"packages": [...]} と Composer 1 の [...] のどちらでも、パッケージの中の並びは同じ.
# "name" の行の後、次のパッケージの "name" より先に "version" が無ければ、何も出さない(別のパッケージの版を拾わないため).
# 1 行にまとめられた JSON など、前提と違う形なら何も出さず、呼び出し側が wp package list で読み直す.
installed_json_version() {
	LC_ALL=C awk -v pkg="$2" '
		!found && index($0, "\"name\"") && index($0, "\"" pkg "\"") { found = 1; next }
		found && /"name"[[:space:]]*:/ { exit }
		found && /"version"[[:space:]]*:/ {
			sub(/^[^:]*:[[:space:]]*"/, "")
			sub(/".*$/, "")
			print
			exit
		}
	' "$1" 2>/dev/null
}

# dist-archive の版. まず WP-CLI のパッケージの置き場所の installed.json から読み、読めなければ wp package list で読む.
# 理由: wp package list は Composer を読み込むので 1 回 1.5〜1.7 秒かかり(2026-10-28 の実測)、Zip を作るたびの待ちと、
#   テストの時間の半分以上を占めていた. wp package path は 0.38 秒(同じ日の実測).
# 同じ値になる根拠(WP-CLI 2.12.0 の phar の中のソースで確認): wp package list は、Composer のローカルのリポジトリ
#   (Composer の Factory.php で vendor/composer/installed.json)の各パッケージの getPrettyVersion()(= "version" の値)を出す.
# 版の先頭の 'v' は取る(タグの記録は今までどおり '3.1.0' の形).
# 状態ごとの動き: package path が失敗・installed.json が無い・パッケージの行が無い・版の形でない → wp package list で読む.
#   それも読めなければ 'unknown'.
dist_archive_version() {
	local v="" dir
	dir="$("${WP_BIN}" package path 2>/dev/null </dev/null | grep -v -i 'deprecated' | head -n 1 | tr -d '\r')"
	if [ -n "${dir}" ] && [ -f "${dir%/}/vendor/composer/installed.json" ]; then
		v="$(installed_json_version "${dir%/}/vendor/composer/installed.json" wp-cli/dist-archive-command)"
		v="${v#v}"
		# 版の形(英数字で始まり、英数字・. _ + - だけ)でなければ使わない. タグのメッセージに妙な文字を入れないため.
		valid_version "${v}" || v=""
	fi
	if [ -z "${v}" ]; then
		v="$("${WP_BIN}" package list --fields=name,version --format=csv 2>/dev/null </dev/null | sed -n 's#^wp-cli/dist-archive-command,v\{0,1\}##p' | head -n 1 | tr -d '\r')"
	fi
	printf '%s' "${v:-unknown}"
}

zip_version() {
	local v
	v="$(zip -v 2>&1 </dev/null | sed -n 's/^This is Zip \([^ ]*\).*$/\1/p' | head -n 1)"
	printf '%s' "${v:-unknown}"
}

# コミッターの名前・メールが決まっているか(注釈付きタグを打つのに要る). 決まっていなければ止める.
# `git var GIT_COMMITTER_IDENT` は、名前やメールを自動で決められないときに失敗する.
check_git_identity() {
	git -C "${CONFIG_DIR}" var GIT_COMMITTER_IDENT >/dev/null 2>&1 ||
		die "Git のコミッターの名前・メールが決まっていません(注釈付きタグを打てません). 次を設定してください:
  git config user.name \"あなたの名前\"
  git config user.email \"you@example.com\""
}

# 注釈付きタグを打つ. 打てなければ非 0 を返す(Zip の後始末は呼び出し側).
#   $1 = タグ名 / $2 = コミット / $3 = スラッグ / $4 = 版 / $5 = Zip のパス / $6 = 1 なら署名付き(git tag -s. --sign)
# 署名は Git と gpg に任せる(このツールは鍵を扱わない). 署名できなければタグは打たれず、非 0 を返す(呼び出し側が Zip を消す).
# --sign なしでも、利用者が git config tag.gpgSign true にしていれば、Git が署名する(git tag -a の仕様).
# メッセージ: 1 行目 = '<スラッグ> <版>'. 本文 = Zip の名前・SHA-256・内容の指紋・ツールの版・Zip を作った道具(WP-CLI・dist-archive・zip)の版.
#   SHA-256         = 配布した Zip そのもの(バイト列)の SHA-256. 手元の Zip が配布したものと同じかを確かめるための記録.
#   Content-SHA-256 = Zip の内容の指紋(zip_content_digest). --rebuild が、作り直した Zip の内容と比べる.
#                     Zip 全体の SHA-256 は作り直すたびに変わるので、比べるのはこちら. 必ず書く(展開できなければタグを打たずに止める).
create_tag() {
	local tag="$1" commit="$2" slug="$3" ver="$4" zip_file="$5" sign="${6:-0}" content tagopt="-a"
	[ "${sign}" -eq 0 ] || tagopt="-s"
	content="$(zip_content_digest)" || content=""
	if [ -z "${content}" ]; then
		err "${PROG}: Zip を展開できず、内容の指紋を作れません(指紋のないタグは打ちません)."
		return 1
	fi
	{
		printf '%s %s\n\nZip: %s\nSHA-256: %s\n' "${slug}" "${ver}" "$(basename "${zip_file}")" "$(sha256_of "${zip_file}")"
		printf 'Content-SHA-256: %s\n' "${content}"
		printf 'Built-with: %s %s\n' "${PROG}" "${WP_RELEASE_ZIP_MAKER_VERSION}"
		printf 'WP-CLI: %s\n' "$(wp_cli_version)"
		printf 'dist-archive: %s\n' "$(dist_archive_version)"
		printf 'zip: %s\n' "$(zip_version)"
	} | git -C "${GIT_TOP}" tag "${tagopt}" -F - "${tag}" "${commit}"
}

# タグのメッセージに記録された値を標準出力へ出す(無ければ何も出さない). $1 = タグ名 / $2 = 見出し('SHA-256' など).
# 見出しは行頭から探すので、'SHA-256' が 'Content-SHA-256' に当たることはない.
tag_recorded_field() {
	git -C "${GIT_TOP}" tag -l --format='%(contents)' "$1" | sed -n "s/^$2: *\\([0-9a-f]*\\).*\$/\\1/p" | head -n 1
}

# --- ref(コミット・タグ)の内容を読む -----------------------------------------------------------
# build と --rebuild は、作業ツリーのファイルではなく、Zip の元になる ref の内容から版と check を読む
# (--rebuild は「タグの時点で確かめる」ため. build も HEAD から読めば、Zip に入る内容と版の確認が一致する).

# Git のルートから見た設定ファイルの場所('app/public/' など. ルートなら空). cmd_build が埋める.
PREFIX=""

# 対象のパス $1(設定ファイルからの相対)の、Git のルートからのパスを標準出力へ出す(末尾の / なし. ルートそのものなら空).
tree_path_of() {
	if [ "$1" = "." ]; then
		printf '%s' "${PREFIX%/}"
	else
		printf '%s%s' "${PREFIX}" "$1"
	fi
}

# ref の時点に、設定ファイルからの相対パス $2 のファイル(またはディレクトリ)があるか. $1 = ref.
# 使い道は、設定ファイルからの相対パスで読むもの(.distignore・check の対象のファイル)だけ.
# 版の読み取りには使わない: 版は read_version_in と src_*(作業ツリーと ref の違いを閉じ込めた入口)の 1 か所で読む(2026-10-28 のレビュー 4 への回答).
blob_exists() {
	git -C "${GIT_TOP}" cat-file -e "${1}:${PREFIX}${2}" 2>/dev/null
}

# ref の時点の、設定ファイルからの相対パス $2 のファイルの中身を標準出力へ出す. $1 = ref.
# blob_exists と同じく、.distignore・check の対象のファイルを読むためのもの. 版の読み取りには使わない(read_version_in と src_* を使う).
blob_cat() {
	git -C "${GIT_TOP}" show "${1}:${PREFIX}${2}" 2>/dev/null
}

# ref の時点で、版を読むファイルの名前(対象のディレクトリの中での名前)を標準出力へ出す. 無ければ 1 を返す.
#   $1 = 種類 / $2 = 対象のパス(設定ファイルからの相対) / $3 = ref
version_file_at() {
	version_file_in "$1" ref "$3" "$(tree_path_of "$2")"
}

# ref の時点の版を標準出力へ出す. 読めなければ何も出さず 1 を返す.
#   $1 = 種類 / $2 = 対象のパス(設定ファイルからの相対) / $3 = ref
read_version_at() {
	read_version_in "$1" ref "$3" "$(tree_path_of "$2")"
}

# --- build / --dry-run / --rebuild --------------------------------------------------------------

# --dry-run --verify-content: Zip を一時ディレクトリに作り、本番と同じ確認(make_zip の中の検査・大きさの上限・名前の警告)をして、
# サマリーを出し、Zip を消す. 出力先・タグ・マニフェストには何も作らない(make_zip に、置かないと伝える).
# --rebuild のときは、タグの記録の指紋との比較も出す(確認だけなので、違っても止めない).
# 確認に落ちたときは、本番と同じメッセージで止まる(終了コード 1). 一時ディレクトリは、終了時に cleanup_tmp が消す.
#   $1 = スラッグ / $2 = 対象のパス / $3 = ref / $4 = 本番なら置く Zip のパス(名前の元) / $5 = 種類 / $6 = 1 なら --rebuild / $7 = タグ名
verify_content_run() {
	local slug="$1" path="$2" ref="$3" zip_file="$4" kind="$5" rebuild="$6" tag="$7"
	printf '\n--- --verify-content: Zip を一時ディレクトリに作り、中身まで確かめます(出力先・タグ・マニフェストには何も作りません)---\n'
	make_zip "${slug}" "${path}" "${ref}" "${zip_file}" "${kind}" 0
	printf '\n'
	print_zip_summary "${slug}" "${BUILT_ZIP}"
	[ "${rebuild}" -eq 0 ] || check_rebuild_digest "${tag}" "${BUILT_ZIP}" 0 1
	rm -f -- "${BUILT_ZIP}"
	printf '\n[verify-content] 中身の確認はすべて通りました. 確認用の Zip は消しました(出力先には何も作っていません).\n'
}

# 標準入力から答えられるか(端末か). テスト用の環境変数 WP_RELEASE_ZIP_MAKER_ASSUME_TTY=1 があれば、端末と見なす
# (自動テストは、答えをパイプで渡すため、端末ではない. README の「開発・テスト」に、テスト用であることを書く).
stdin_is_terminal() {
	[ "${WP_RELEASE_ZIP_MAKER_ASSUME_TTY:-0}" = "1" ] || [ -t 0 ]
}

# 「main」と答えたときの切り替え先になるブランチ(既定のブランチ)を標準出力へ出す. refs/heads/main があれば main、
# 無くて refs/heads/master があれば master. どちらも無ければ何も出さず 1 を返す(両方あるときは main).
# 今いるのが main / master のときは、この確認自体が出ない(cmd_build の case で対象外).
default_branch() {
	local b
	for b in main master; do
		if git -C "${GIT_TOP}" show-ref --verify --quiet "refs/heads/${b}"; then
			printf '%s' "${b}"
			return 0
		fi
	done
	return 1
}

# main / master 以外のブランチ(detached HEAD も)から Zip とタグを作ってよいかを、端末で聞く(build のときだけ).
# 事前の確認がすべて通ったあと・Zip を作る前に呼ぶ(y と答えたあとで別の理由で止まらないように).
#   $1 = ブランチ名(detached HEAD は '(detached HEAD)') / $2 = 1 なら聞かずに進む(--yes)
# 状態: --yes → 進む / 端末から答えられない(標準入力が端末でない)→ 止める(終了コード 1) /
#       y・yes → 進む / n・no・空の Enter・入力の終わり(Ctrl-D)→ やめる(終了コード 1) /
#       main(既定のブランチの名前. 既定のブランチがあるときだけ選べる)→ 切り替えて起動し直す(switch_to_default_and_restart) /
#       それ以外 → もう一度聞く. 大文字小文字は区別しない.
# 端末が無いときに止めるのは、確認を黙って飛ばすと、スクリプトや CI が誤ったブランチからリリースを作れてしまうため(--yes で明示的に通す).
confirm_branch() {
	local branch="$1" yes="$2" def="" ans options
	[ "${yes}" -eq 0 ] || return 0
	def="$(default_branch)" || def=""
	if ! stdin_is_terminal; then
		die "端末から答えられないので、止めます(${branch} から Zip とタグを作る確認が出せません). 続けるなら --yes を付けてください.${def:+ ${def} で作るなら、先に git switch ${def} してください.}"
	fi
	# 起動し直したあとでも main / master 以外なら、切り替えが効いていない. もう一度「main」を勧めると、切り替えを繰り返すので止める.
	if [ -n "${!SWITCHED_FROM_VAR:-}" ]; then
		die "${!SWITCHED_FROM_VAR} から切り替えて起動し直しましたが、まだ ${branch} です(切り替えが効いていません). ブランチを確かめてください."
	fi
	options="[y]es / [n]o"
	[ -z "${def}" ] || options="${options} / ${def}(${def} に切り替えて作る)"
	while :; do
		printf 'このまま %s で Zip とタグを作りますか? %s: ' "${branch}" "${options}" >&2
		# 入力の終わり(Ctrl-D)は、読めなかったこととして「やめる」にする.
		IFS= read -r ans || ans=""
		ans="$(printf '%s' "${ans}" | tr '[:upper:]' '[:lower:]')"
		case "${ans}" in
			y | yes) return 0 ;;
			n | no | '')
				err ""
				err "${PROG}: やめました. Zip もタグも作っていません. ブランチは変えていません."
				exit "${EXIT_STOP}"
				;;
			*)
				# 既定のブランチの名前(main か master)が答えなら、切り替える. 既定のブランチが無ければ、選択肢に無いので、ここへ来ない.
				if [ -n "${def}" ] && [ "${ans}" = "${def}" ]; then
					switch_to_default_and_restart "${branch}" "${def}"
				fi
				err "  y か n${def:+ か ${def}} で答えてください."
				;;
		esac
	done
}

# 「main」(既定のブランチ)と答えたとき: 今の HEAD が既定のブランチに入っていることを確かめ、切り替え、同じ引数でツールを起動し直す.
#   $1 = 今のブランチ名 / $2 = 既定のブランチ名
# 入っていなければ(マージされていなければ)切り替えずに止める(終了コード 1). 切り替えても、そのコミットは Zip に入らず、
#   気づかないまま、マージ前の変更を含まないリリースを作ってしまうため.
# 切り替えに失敗したら(未追跡のファイルがぶつかるなど)、Git のエラーを出して止める(ブランチは元のまま).
# 起動し直す(exec)のは、版・check・タグの有無・Zip の名前を、すべて切り替えたあとの HEAD で確かめ直すため(切り替える前に読んだ値を使い回さない).
#   起動し直したあとは、既定のブランチにいるので、もう聞かない(無限ループにならない). 元のブランチ名は環境変数で渡し、最後の表示に使う.
switch_to_default_and_restart() {
	local from="$1" def="$2" n out
	if ! git -C "${GIT_TOP}" merge-base --is-ancestor HEAD "${def}" 2>/dev/null; then
		n="$(git -C "${GIT_TOP}" rev-list --count "${def}..HEAD" 2>/dev/null)" || n="?"
		die "${from} の ${n} 個のコミットが ${def} に入っていません. 切り替えても、それらは Zip に入りません. 先に ${def} へマージしてから実行してください. ブランチは変えていません."
	fi
	if ! out="$(git -C "${GIT_TOP}" switch "${def}" 2>&1)"; then
		err "${out}"
		die "${def} へ切り替えられませんでした(Git のエラーは上のとおり). ブランチは変えていません."
	fi
	err "${def} に切り替えました(HEAD $(git -C "${GIT_TOP}" rev-parse --short HEAD)). ${def} で改めて確かめます."
	export "${SWITCHED_FROM_VAR}=${from}"
	# ORIG_ARGS は、スラッグがあるので空にならない(bash 3.2 は、空の配列を set -u の下で展開すると落ちる).
	exec "${BASH}" "$0" "${ORIG_ARGS[@]}"
}

# 3 つの動作の事前の確認と実行.
#   $1 = スラッグ / $2 = dry-run(1 = 確認だけ) / $3 = rebuild(1 = 既存のタグから作り直す) / $4 = --rebuild で指定された版(空ならなし)
#   $5 = 1 なら、内容の不一致でも続ける(--allow-content-change) / $6 = 1 なら、マニフェストも作る(--manifest)
#   $7 = 1 なら、署名付きのタグを打つ(--sign. 通常の実行だけ)
#   $8 = 1 なら、--dry-run のあと Zip を一時ディレクトリに作って中身まで確かめ、消す(--verify-content. --dry-run のときだけ)
#   $9 = JSON のレポートを作るパス(絶対パス. 空なら作らない. --json. --dry-run とは使えない)
#   ${10} = 1 なら、main / master 以外のブランチからの確認を飛ばして進む(--yes. 通常の実行だけ)
#
# build: HEAD の内容から Zip を作り、注釈付きタグを打つ(push はしない). 作業ツリーがきれいなこと・タグも Zip も無いことが要る.
# rebuild: 既存のタグの時点の内容から Zip だけを作り直す(タグは打たない). 作業ツリーの状態は問わない.
#   版は、指定が無ければ HEAD の版. タグが無ければ止める. 出力先に同名の Zip があれば止める.
# 確かめる順: 道具 → HEAD の有無 → ref(HEAD またはタグ)の対象と .distignore → 作業ツリー(build だけ)→
#   版と check → タグ → 出力先の Zip.
cmd_build() {
	local slug="$1" dry="$2" rebuild="$3" want_ver="$4" allow_change="$5" manifest="$6" sign="$7" verify_content="${8:-0}" json_file="${9:-}" yes="${10:-0}" manifest_file=""
	local kind path tp ref refdesc head_sha ver tver vname vrel tag out zip_file branch short

	load_config
	find_target "${slug}"
	kind="${T_KIND[${TI}]}"
	path="${T_PATH[${TI}]}"

	check_tools

	git -C "${CONFIG_DIR}" rev-parse -q --verify HEAD >/dev/null 2>&1 ||
		die "このリポジトリにはコミットがまだありません(Zip は HEAD かタグから作ります)."
	PREFIX="$(git -C "${CONFIG_DIR}" rev-parse --show-prefix)" || die "Git のルートからの位置を取得できません."
	tp="$(tree_path_of "${path}")"
	head_sha="$(git -C "${GIT_TOP}" rev-parse HEAD)"

	# --- Zip の元になる ref を決める -------------------------------------------------------------
	if [ "${rebuild}" -eq 1 ]; then
		# 版: 指定があればそれ. 無ければ HEAD の版.
		if [ -n "${want_ver}" ]; then
			ver="${want_ver}"
		else
			ver="$(read_version_at "${kind}" "${path}" HEAD)" ||
				die "HEAD の '${path}' から版を読めません(${kind}: $(version_source "${kind}")). 作り直したい版を '${PROG} ${slug} --rebuild <版>' で指定することもできます."
		fi
		valid_version "${ver}" ||
			die "版 '${ver}' は、タグ名とファイル名に使えない形です(英数字で始まり、英数字・. _ + - だけ)."
		tag="$(make_tag "${slug}" "${ver}")"
		git check-ref-format "refs/tags/${tag}" ||
			die "タグ名 '${tag}' は Git のタグ名として使えません(tag_format を見直してください)."
		tag_exists "${tag}" ||
			die "タグ ${tag} がありません. --rebuild は、打ってあるタグから Zip を作り直すためのものです.
  新しく作るなら、版を確かめて '${PROG} ${slug}' を実行してください(タグも打ちます).
  HEAD と違う版を作り直すなら、'${PROG} ${slug} --rebuild <版>' で指定してください."
		ref="$(git -C "${GIT_TOP}" rev-parse "refs/tags/${tag}^{commit}")" || die "タグ ${tag} のコミットを取得できません."
		refdesc="タグ ${tag}"
	else
		ref="${head_sha}"
		refdesc="HEAD"
		# 注釈付きタグを打つので、コミッターの名前・メールが要る(Zip を作ってから失敗しないよう、先に確かめる).
		check_git_identity
	fi

	# --- 対象のディレクトリと .distignore(ref の時点). dist-archive は .distignore が無いと全ファイルを入れてしまうので止める ---
	# パスが '.' のとき、blob_exists の '<ref>:<PREFIX>.' は Git が解釈できない. Git のルートからのパス(tp)で指す.
	git -C "${GIT_TOP}" cat-file -e "${ref}:${tp}" 2>/dev/null ||
		die "対象のディレクトリ '${path}' が ${refdesc} にありません."
	blob_exists "${ref}" "$(rel_join "${path}" .distignore)" ||
		die "'${path}' に、${refdesc} の時点でコミット済みの .distignore がありません.
  wp dist-archive は .distignore が無いと、node_modules・src・設定ファイルを含む全ファイルを Zip に入れます.
  Zip に入れないものを書いた .distignore を作り、コミットしてください(--rebuild では、タグの時点に無ければ作り直せません)."

	# --- 作業ツリー(build だけ. rebuild はタグの時点から作るので、作業ツリーを使わない) -----------
	if [ "${rebuild}" -eq 0 ]; then
		check_clean_tree
	fi

	# --- 版(ref の時点のファイルから読む) ---------------------------------------------------------
	vname="$(version_file_at "${kind}" "${path}" "${ref}")" ||
		die "'${path}' の版を読むファイルが ${refdesc} にありません(${kind}: $(version_source "${kind}"))."
	vrel="$(rel_join "${path}" "${vname}")"
	tver="$(read_version_at "${kind}" "${path}" "${ref}")" ||
		die "${refdesc} の ${vrel} から版を読めません(${kind}: $(version_source "${kind}"))."
	valid_version "${tver}" ||
		die "版 '${tver}' は、タグ名とファイル名に使えない形です(英数字で始まり、英数字・. _ + - だけ)."
	if [ "${rebuild}" -eq 1 ]; then
		# タグ名の版と、タグの時点のファイルの版が違えば、タグが別の版のコミットを指している.
		[ "${tver}" = "${ver}" ] ||
			die "${refdesc} の時点の版は ${tver} で、タグ名の版 ${ver} と食い違っています(タグが別のコミットを指していませんか)."
	else
		ver="${tver}"
	fi

	# --- check: 版の表記がそろっているか. 食い違いはすべて表示してから止める -----------------------
	check_version_files "${TI}" "${ver}" "${ref}"
	if [ "${CHECK_BAD}" -gt 0 ]; then
		err "${PROG}: 版の表記がそろっていません(${refdesc} の ${vrel} の版 = ${ver} / 食い違い ${CHECK_BAD} 件 / 確認 ${CHECK_TOTAL} 件)."
		exit "${EXIT_STOP}"
	fi

	# --- タグと出力先の Zip. 組み合わせ表の「タグ」「出力先の Zip」の列 -----------------------------
	out="$(output_dir)"
	zip_file="${out}/${slug}.${ver}.zip"
	if [ "${rebuild}" -eq 1 ]; then
		{ [ ! -e "${zip_file}" ] && [ ! -L "${zip_file}" ]; } ||
			die "Zip がすでにあります(${zip_file}). このツールは上書きしません. 作り直すなら、確かめて消してから実行してください."
	else
		tag="$(make_tag "${slug}" "${ver}")"
		git check-ref-format "refs/tags/${tag}" ||
			die "タグ名 '${tag}' は Git のタグ名として使えません(tag_format を見直してください)."
		if tag_exists "${tag}"; then
			if [ -e "${zip_file}" ] || [ -L "${zip_file}" ]; then
				die "タグ ${tag} も Zip もすでにあります(${zip_file}). 新しい版を作るなら版を上げてください. 同じ版を作り直すなら、Zip を消してから --rebuild を使ってください."
			fi
			die "タグ ${tag} はすでにあります. 新しい版を作るなら版を上げてください. 同じ版の Zip を作り直すなら --rebuild を使ってください."
		fi
		if [ -e "${zip_file}" ] || [ -L "${zip_file}" ]; then
			die "タグ ${tag} は無いのに、Zip がすでにあります(${zip_file}). 前回の作りかけか、別の作業の Zip です. 確かめて消してから実行してください."
		fi
	fi

	# JSON のレポート(--json): 上書きしない. すでにあれば、何も作らずに止める(Zip とタグを作ってから分かると、記録だけが残らないため、ここで確かめる).
	# 作る時点で置けなかったときは、Zip とタグを残したまま警告する(finish_json_report)ので、ここで防げるのは「すでにある」だけ.
	if [ -n "${json_file}" ] && { [ -e "${json_file}" ] || [ -L "${json_file}" ]; }; then
		die "JSON のレポートがすでにあります(${json_file}). このツールは上書きしません. 確かめて消してから実行してください."
	fi

	# マニフェスト(--manifest): Zip と同じく上書きしない. すでにあれば、何も作らずに止める(Zip だけ作ってから止まらないよう、ここで確かめる).
	if [ "${manifest}" -eq 1 ]; then
		manifest_file="${out}/${slug}.${ver}.manifest.txt"
		if [ -e "${manifest_file}" ] || [ -L "${manifest_file}" ]; then
			die "マニフェストがすでにあります(${manifest_file}). このツールは上書きしません. 確かめて消してから実行してください."
		fi
	fi

	# 出力先が Git の中で、無視もされていなければ、作った Zip が次回の作業ツリーを汚す(警告だけ).
	case "${out}/" in
		"${GIT_TOP}"/*)
			if ! git -C "${CONFIG_DIR}" check-ignore -q -- "${zip_file}" 2>/dev/null; then
				err "警告: 出力先 ${out} は Git のリポジトリの中で、.gitignore にも入っていません. 作った Zip が未追跡ファイルになり、次回は作業ツリーが汚れて止まります. Git の外を指すことを勧めます."
			fi
			;;
	esac

	# ブランチ(build だけ. タグを打つコミットがどこかを確かめやすいよう表示する)
	branch="$(git -C "${CONFIG_DIR}" branch --show-current)"
	if [ "${rebuild}" -eq 0 ]; then
		case "${branch}" in
			main | master) ;;
			'')
				err "警告: HEAD がブランチにありません(detached HEAD). 意図したコミットか確かめてください."
				branch="(detached HEAD)"
				;;
			*) err "警告: ブランチは ${branch} です(main / master ではありません). リリースのタグを打つコミットか確かめてください." ;;
		esac
		# main / master 以外(detached HEAD を含む)からは、本番の実行では続けるかを聞く. --dry-run は聞かず、聞くことだけ添える(ブランチは変えない).
		case "${branch}" in
			main | master) ;;
			*)
				if [ "${dry}" -eq 1 ]; then
					err "  [dry-run] 本番の実行では、このまま作るかを聞きます(y/n$(default_branch | sed 's#^#/#'). 端末から答えられなければ止まります. --yes で飛ばせます)."
				else
					confirm_branch "${branch}" "${yes}"
				fi
				;;
		esac
	fi
	short="$(git -C "${GIT_TOP}" rev-parse --short "${ref}")"

	# --- --dry-run: 要約だけ出して終わる ---------------------------------------------------------
	if [ "${dry}" -eq 1 ]; then
		printf '[dry-run] Zip もタグも作りません. 事前の確認はすべて通りました.\n\n'
		printf '動作:       %s\n' "$([ "${rebuild}" -eq 1 ] && echo "--rebuild(${refdesc} から Zip だけを作り直す)" || echo "build(HEAD から Zip を作り、タグを打つ)")"
		printf '対象:       %s (%s)\n' "${slug}" "${kind}"
		printf 'パス:       %s\n' "${path}"
		printf '版:         %s (%s)\n' "${ver}" "${vrel}"
		if [ "${CHECK_TOTAL}" -eq 0 ]; then
			printf 'check:      なし(この対象に check の行はありません)\n'
		else
			printf 'check:      %s 件とも一致\n' "${CHECK_TOTAL}"
		fi
		if [ "${rebuild}" -eq 1 ]; then
			printf 'タグ:       %s (あります・コミット %s)\n' "${tag}" "${short}"
		else
			printf 'ブランチ:   %s\n' "${branch}"
			printf 'タグ:       %s (まだありません・打つコミット %s)\n' "${tag}" "${short}"
		fi
		printf 'Zip:        %s\n' "${zip_file}"
		[ "${manifest}" -eq 0 ] || printf 'マニフェスト: %s\n' "${manifest_file}"
		[ "${sign}" -eq 0 ] || printf '署名:       する(git tag -s. gpg と鍵が要ります. 署名できなければ、タグも Zip も作りません)\n'
		[ "${verify_content}" -eq 0 ] || verify_content_run "${slug}" "${path}" "${ref}" "${zip_file}" "${kind}" "${rebuild}" "${tag}"
		return 0
	fi

	# --- 実行 ----------------------------------------------------------------------------------
	if [ "${rebuild}" -eq 1 ]; then
		printf '%s (%s) を作り直します: 版 %s・%s(コミット %s)\n' "${slug}" "${kind}" "${ver}" "${refdesc}" "${short}"
		make_zip "${slug}" "${path}" "${ref}" "${zip_file}" "${kind}"
		printf '\n'
		print_zip_summary "${slug}" "${zip_file}"
		check_rebuild_digest "${tag}" "${zip_file}" "${allow_change}"
		# 内容の指紋の確認のあとで作る(不一致で止めるとき、マニフェストを残さない). 作れなければ Zip も消す.
		if [ "${manifest}" -eq 1 ]; then
			write_manifest "${zip_file}" "${manifest_file}" || { rm -f -- "${zip_file}"; die "マニフェストを作れませんでした(Zip は消しました)."; }
		fi
		finish_json_report "${json_file}" "${slug}" "${kind}" "${ver}" rebuild "${tag}" "${ref}" "" "${zip_file}" "$([ "${manifest}" -eq 1 ] && printf '%s' "${manifest_file}")" 0 "${REBUILD_CONTENT_MATCH}"
		print_deploy_hint "${kind}" "${slug}" "${ver}" "${tag}" "${zip_file}"
		end_json_report
		return 0
	fi

	printf '%s (%s) を作ります: 版 %s・HEAD %s\n' "${slug}" "${kind}" "${ver}" "${short}"
	make_zip "${slug}" "${path}" "${ref}" "${zip_file}" "${kind}"
	# タグを打てなければ、Zip も消す(「タグの無い Zip」を残すと、次回の実行が止まるため).
	# マニフェストは、タグより先に作る(作れなければ、タグを打たずに Zip も消す). タグを打てなければ、マニフェストも消す.
	if [ "${manifest}" -eq 1 ]; then
		write_manifest "${zip_file}" "${manifest_file}" || { rm -f -- "${zip_file}"; die "マニフェストを作れませんでした(Zip は消しました). Zip を展開できるか確かめてください."; }
	fi
	if ! create_tag "${tag}" "${ref}" "${slug}" "${ver}" "${zip_file}" "${sign}"; then
		rm -f -- "${zip_file}"
		[ "${manifest}" -eq 0 ] || rm -f -- "${manifest_file}"
		die "タグ ${tag} を打てませんでした(Zip は消しました). Git のエラーを確かめてから、もう一度実行してください.$([ "${sign}" -eq 0 ] || printf '\n  --sign: gpg が使えるか(gpg --list-secret-keys)・署名する鍵(git config user.signingkey)・パスフレーズの入力(pinentry)を確かめてください.')"
	fi
	printf '\n'
	print_zip_summary "${slug}" "${zip_file}"
	printf '\nタグ:       %s を打ちました(注釈付き%s・コミット %s).\n' "${tag}" "$([ "${sign}" -eq 0 ] || printf '・署名付き')" "${short}"
	printf '            push はしていません. 共有するなら: git push <リモート名> %s\n' "${tag}"
	# 「main」と答えて切り替えたときは、ブランチが元と違うことを、最後に添える(元のブランチには戻さない).
	[ -z "${!SWITCHED_FROM_VAR:-}" ] || printf 'ブランチ:   %s に切り替えました(元は %s). 戻すなら: git switch %s\n' "${branch}" "${!SWITCHED_FROM_VAR}" "${!SWITCHED_FROM_VAR}"
	finish_json_report "${json_file}" "${slug}" "${kind}" "${ver}" build "${tag}" "${ref}" "$([ "${branch}" = "(detached HEAD)" ] || printf '%s' "${branch}")" "${zip_file}" "$([ "${manifest}" -eq 1 ] && printf '%s' "${manifest_file}")" "${sign}" ""
	print_deploy_hint "${kind}" "${slug}" "${ver}" "${tag}" "${zip_file}"
	end_json_report
}

# --json の最後の始末. Zip とタグができたあと(手順の表示の前)に、レポートを作る. 作れなくても止めない(手順の表示まで進める).
# 作れなかったら JSON_REPORT_FAILED を立て、end_json_report が、手順の表示のあとに終了コード 1 で終わる.
# 理由: JSON は記録のためのもので、配布物ではない. Zip とタグは正しくできているので、消さない(--manifest は配布物と対なので、作れなければ Zip も消す).
#   引数は write_json_report と同じ(最初の $1 が空なら、何もしない).
JSON_REPORT_FAILED=0
finish_json_report() {
	[ -n "$1" ] || return 0
	write_json_report "$@" || JSON_REPORT_FAILED=1
}

end_json_report() {
	[ "${JSON_REPORT_FAILED}" -eq 1 ] || return 0
	err ""
	err "${PROG}: JSON のレポートを作れませんでした. Zip とタグは、正しくできています(消していません). レポートだけ、確かめてから作り直してください."
	exit "${EXIT_STOP}"
}

# 内容が違ったとき、Zip を作った道具の版を「タグの記録 → 今回」で並べて表示する(違うものに印を付ける).
# 記録の無い欄(旧タグ)は「(記録なし)」とし、違いの印は付けない. 記録があるものがすべて同じなら、そう伝える.
#   $1 = タグ名
print_tool_version_comparison() {
	local tag="$1" key label rec now diff=0 unrecorded=0 mark
	printf '  使った道具の版(タグの記録 → 今回):\n'
	for key in wp_cli dist_archive zip; do
		case "${key}" in
			wp_cli) label="WP-CLI"; now="$(wp_cli_version)" ;;
			dist_archive) label="dist-archive"; now="$(dist_archive_version)" ;;
			zip) label="zip"; now="$(zip_version)" ;;
		esac
		rec="$(tag_recorded_text "${tag}" "${label}")"
		mark=""
		if [ -z "${rec}" ]; then
			rec="(記録なし)"
			unrecorded=1
		elif [ "${rec}" != "${now}" ]; then
			mark="  ← 違います"
			diff=1
		fi
		printf '    %-13s %s → %s%s\n' "${label}:" "${rec}" "${now}" "${mark}"
	done
	if [ "${diff}" -eq 0 ] && [ "${unrecorded}" -eq 0 ]; then
		printf '  道具の版はすべて同じです(違いの原因は、版以外にあります. たとえば、タグの後に変わった環境や、zip の動作の差です).\n'
	fi
}

# --rebuild で作り直した Zip を、タグに記録された値と比べて表示する. 内容の指紋が記録と違えば、止める(終了コード 1・Zip は消す).
# 比べるのは「内容の指紋」. Zip 全体の SHA-256 は、同じコミットから作り直しても毎回変わる(zip が時刻などの属性を入れるため)ので、
# 一致しなくてよい. 配布済みの Zip と同じか確かめたいときは、その Zip の SHA-256 を、タグに記録された SHA-256 と比べる.
# 止める理由: 同じタグから作ったのに内容が違うのは、.distignore・zip・wp dist-archive の版などが変わって、配布する中身が変わっている状態.
#             警告だけで手順の表示まで進むと、そのままアップロードされてしまう(2026-10-26 のレビュー). 意図した差なら --allow-content-change で続ける.
# 止めないとき: 指紋が一致・タグに記録がない(古いタグ・軽量タグ)・指紋を計算できない(Zip を展開できない)は、比べようがないので警告だけ.
#   $1 = タグ名 / $2 = 作り直した Zip のパス / $3 = 1 なら、不一致でも続ける(--allow-content-change)
#   $4 = 1 なら、確認だけ(--dry-run --verify-content). 不一致でも止めない(Zip は一時ディレクトリのもので、どのみち消える)
check_rebuild_digest() {
	local tag="$1" zip_file="$2" allow="$3" verify_only="${4:-0}" now recorded mismatch=0
	recorded="$(tag_recorded_field "${tag}" "Content-SHA-256")"
	now="$(zip_content_digest)" || now=""
	printf '\nタグとの比較:\n'
	if [ -z "${now}" ]; then
		printf '  Zip を展開できず、内容の指紋を計算できませんでした. 中身(上の内訳)を目で確かめてください.\n'
	elif [ -z "${recorded}" ]; then
		printf '  タグ %s に、内容の指紋(Content-SHA-256)の記録がありません(古いタグ、または別の方法で打ったタグ). 中身(上の内訳)を目で確かめてください.\n' "${tag}"
	elif [ "${recorded}" = "${now}" ]; then
		REBUILD_CONTENT_MATCH=1
		printf '  内容の指紋が、タグの記録と一致しました(元の Zip と同じファイル・同じ内容です).\n'
	else
		mismatch=1
		REBUILD_CONTENT_MATCH=0
		printf '  内容の指紋が、タグの記録と違います.\n    タグの記録: %s\n    今回:       %s\n' "${recorded}" "${now}"
		printf '  .distignore・zip・wp dist-archive の版や、タグの後の環境の違いで、入るファイルが変わった可能性があります. 中身(上の内訳)を確かめてください.\n'
		print_tool_version_comparison "${tag}"
	fi
	# 配布した Zip の現物との照合用に、タグに記録された SHA-256 を添える(記録がなければ何も言わない).
	recorded="$(tag_recorded_field "${tag}" "SHA-256")"
	if [ -n "${recorded}" ]; then
		printf '  (Zip 全体の SHA-256 は、作り直すたびに変わります. 配布した Zip の現物は、タグに記録された SHA-256 と照合してください: %s)\n' "${recorded}"
	fi
	[ "${mismatch}" -eq 1 ] || return 0
	if [ "${verify_only}" -eq 1 ]; then
		printf '  --verify-content は確認だけなので、止めません(本番の --rebuild では、--allow-content-change が無ければ止まります).\n'
		return 0
	fi
	if [ "${allow}" -eq 1 ]; then
		printf '  --allow-content-change が指定されているので続行します.\n'
		return 0
	fi
	# 違う内容の Zip を、配布できる名前で残さない. 中身を確かめたいときは、--allow-content-change を付けて作り直す.
	rm -f -- "${zip_file}"
	err ""
	err "${PROG}: 作り直した Zip の内容が、タグ ${tag} の記録と違うので止めました(Zip は消しました)."
	err "  意図した違いなら、'--rebuild --allow-content-change' で作り直し、中身を確かめてから使ってください."
	exit "${EXIT_STOP}"
}

# --- アップロードの手順の表示 -------------------------------------------------------------------

# 文字列を、シェルに 1 つの語として渡せる形にして標準出力へ出す(表示した手順を貼り付けても、意図しないコマンドにならないように).
# 安全な文字だけ(英数字と _ / . , : @ % + = -)なら、そのまま出す. それ以外が 1 つでもあれば、単一引用符で包み、中の ' は '\'' にする.
# 単一引用符の中では、空白・; ・$ ・` ・" ・! ・改行も、シェルは解釈しない. bash・zsh のどちらでも同じ. printf '%q' は使わない:
# bash 3.2 は ASCII 以外のバイトを壊した形($'...')で出すため(2026-10-26 に macOS の /bin/bash で確認).
# LC_ALL=C: ロケールによっては、不正なバイト列を sed が拒否するため.
#   $1 = 文字列
shell_quote() {
	case "$1" in
		'') printf "''" ;;
		*[!A-Za-z0-9_/.,:@%+=-]*) printf "'%s'" "$(printf '%s' "$1" | LC_ALL=C sed "s/'/'\\\\''/g")" ;;
		*) printf '%s' "$1" ;;
	esac
}

# 同じスラッグの、タグ $2 の 1 つ前のタグの版を標準出力へ出す. 前のタグが無ければ何も出さず 1 を返す.
#   $1 = スラッグ / $2 = 基準にするタグ名(すでにあること)
# タグは git の version:refname の並び(1.9.0 < 1.10.0)で並べ、tag_format の {version} の前後を削って版にする.
# 注意: tag_format が {version} だけ(対象が 1 つのリポジトリ)のときは、リポジトリのすべてのタグが対象になる.
# 版の形でないタグ(release-2024 など)が混ざっていると、そのタグを前の版と見なすことがある.
previous_version() {
	local slug="$1" cur_tag="$2" pattern prefix suffix t prev="" found=0 v
	pattern="$(make_tag "${slug}" '*')"
	while IFS= read -r t; do
		if [ "${t}" = "${cur_tag}" ]; then
			found=1
			break
		fi
		prev="${t}"
	done < <(git -C "${GIT_TOP}" tag -l --sort=version:refname "${pattern}")
	{ [ "${found}" -eq 1 ] && [ -n "${prev}" ]; } || return 1
	prefix="${CFG_TAG_FORMAT%%\{version\}*}"
	prefix="${prefix//\{slug\}/${slug}}"
	suffix="${CFG_TAG_FORMAT#*\{version\}}"
	suffix="${suffix//\{slug\}/${slug}}"
	v="${prev#"${prefix}"}"
	v="${v%"${suffix}"}"
	valid_version "${v}" || return 1
	printf '%s' "${v}"
}

# 作った(作り直した)Zip を、サーバーへ上げる手順を表示する.
#   $1 = 種類 / $2 = スラッグ / $3 = 版 / $4 = タグ名 / $5 = Zip のパス
# theme・plugin は管理画面の Zip アップロード. dir は SSH(scp + unzip + mv)の手順を、版とパスを埋めて出す.
# 管理画面のメニュー名は WordPress 7.1 の日本語の表記に合わせる(admin-ja.po の "Add Plugin" = プラグインを追加・
# "Add Theme" = テーマを追加・"Upload Plugin" / "Upload Theme" = プラグイン / テーマのアップロード).
# shellcheck disable=SC2016  # 表示する手順の中の $DOCROOT と $z などは、展開せずにそのまま出す(サーバーで展開される).
print_deploy_hint() {
	local kind="$1" slug="$2" ver="$3" tag="$4" zip_file="$5" prev bak has_version name
	case "${kind}" in
		theme | plugin)
			printf '\nアップロード: 管理画面の「%s」から、この Zip(%s)を上げます.\n' \
				"$([ "${kind}" = "theme" ] && echo '外観 > テーマ > テーマを追加 > テーマのアップロード' || echo 'プラグイン > プラグインを追加 > プラグインのアップロード')" "$(basename "${zip_file}")"
			printf '            Zip の一番上のフォルダー(%s)が、置き換わる対象を決めます.\n' "${slug}"
			return 0
			;;
	esac

	# dir: 前の版(同じスラッグの 1 つ前のタグ). 無ければ、退避先の名前に版を付けない.
	if prev="$(previous_version "${slug}" "${tag}")"; then
		bak="${slug}.bak-${prev}"
	else
		prev=""
		bak="${slug}.bak"
	fi
	name="${slug}.${ver}"
	# Zip に VERSION が入っているか(サーバーで版を確かめる行を出せるか).
	has_version=0
	if unzip -Z1 "${zip_file}" | grep -qx -- "${slug}/VERSION"; then
		has_version=1
	fi

	printf '\n--- アップロードの手順(SSH)---\n'
	printf 'user@host・/path/to/public_html は、自分の環境に置き換える. サーバーの手順は 1 行ずつ確かめながら実行する.\n'
	printf '旧版は、docroot の外(~/releases)へ退避する(docroot の中に置くと、古い版が URL で見えてしまう).\n'
	printf '展開は上書きではなく、新しいディレクトリへ展開して差し替える(新しい版で消したファイルが残らないように).\n'
	printf '\n(ローカル)\n'
	printf "ssh user@host 'mkdir -p ~/releases'\n"
	printf 'scp %s user@host:~/releases/\n' "$(shell_quote "${zip_file}")"
	printf '\n(サーバー)\n'
	printf '# unzip があるか. 無ければ、下の「unzip が無いとき」を使う\n'
	printf 'which unzip\n'
	printf '# %s を置く親のディレクトリ(サーバーでの名前が %s と違うなら、mv の行き先を変える)\n' "${slug}" "${slug}"
	printf 'DOCROOT=/path/to/public_html\n'
	printf '# 同じディスクか. 別だと mv がコピーになり、その間ページが無くなる\n'
	printf 'df ~/releases "$DOCROOT"\n'
	printf 'cd ~/releases\n'
	printf '# 配置前の確認: 次の 4 つがすでにあれば「すでにあります」と表示される(何も出なければ、どれも無い).\n'
	printf '# 表示されたら、ここで止める. 中身を確かめて、要らなければ消すか名前を変えてから、最初からやり直す\n'
	printf 'for p in ~/releases/%s ~/releases/%s.partial ~/releases/%s ~/releases/%s.failed-%s; do if [ -e "$p" ]; then echo "すでにあります: $p"; fi; done\n' "${name}" "${name}" "${bak}" "${slug}" "${ver}"
	printf '# 新しいディレクトリへ展開する(→ ~/releases/%s/%s/). まず %s.partial へ展開し、全部成功したときだけ %s に名前を変える\n' "${name}" "${slug}" "${name}" "${name}"
	printf '# (途中で失敗した展開を、本物の名前にしない. 成功したときだけ EXTRACTED=1 になり、下の退避・差し替えは、それを見て動く)\n'
	printf 'EXTRACTED=\n'
	printf 'if [ -e %s ]; then echo "すでにあります: ~/releases/%s"; else mkdir %s.partial && unzip -q %s.zip -d %s.partial && mv %s.partial %s && EXTRACTED=1; fi\n' \
		"${name}" "${name}" "${name}" "${name}" "${name}" "${name}" "${name}"
	if [ "${has_version}" -eq 1 ]; then
		printf '# 版を確かめる(%s のはず)\n' "${ver}"
		printf 'cat %s/%s/VERSION\n' "${name}" "${slug}"
	fi
	printf '# 旧版を docroot の外へ退避する(初回で旧版が無いときは、この行を飛ばす)\n'
	printf '# (展開が済んでいなければ動かさない. 退避先がすでにあると、mv は中に入れ子で入れてしまうので、ある場合も動かさない)\n'
	printf 'if [ -z "$EXTRACTED" ]; then echo "展開が済んでいないので、動かしません"; elif [ -e ~/releases/%s ]; then echo "すでにあります: ~/releases/%s"; else mv "$DOCROOT/%s" ~/releases/%s; fi\n' "${bak}" "${bak}" "${slug}" "${bak}"
	printf '# 新しい版を置く(展開が済んでいなければ動かさない. 置く場所に旧版が残っていると、mv は中に入れ子で入れてしまうので、ある場合も動かさない)\n'
	printf 'if [ -z "$EXTRACTED" ]; then echo "展開が済んでいないので、動かしません"; elif [ -e "$DOCROOT/%s" ]; then echo "すでにあります: $DOCROOT/%s(旧版の退避に失敗していませんか)"; else mv %s/%s "$DOCROOT/%s"; fi\n' "${slug}" "${slug}" "${name}" "${slug}" "${slug}"
	if [ "${has_version}" -eq 1 ]; then
		printf 'cat "$DOCROOT/%s/VERSION"\n' "${slug}"
	fi
	printf '\n(戻すとき)\n'
	printf 'if [ -e ~/releases/%s.failed-%s ]; then echo "すでにあります: ~/releases/%s.failed-%s"; else mv "$DOCROOT/%s" ~/releases/%s.failed-%s && mv ~/releases/%s "$DOCROOT/%s"; fi\n' \
		"${slug}" "${ver}" "${slug}" "${ver}" "${slug}" "${slug}" "${ver}" "${bak}" "${slug}"
	printf '\n(unzip が無いとき: 上の「if [ -e %s ]」の行の代わりに)\n' "${name}"
	printf "if [ -e %s ]; then echo \"すでにあります: ~/releases/%s\"; else mkdir %s.partial && php -r '\$z=new ZipArchive; if (\$z->open(\$argv[1]) !== true || !\$z->extractTo(\$argv[2])) exit(1);' %s.zip %s.partial && mv %s.partial %s && EXTRACTED=1; fi\n" \
		"${name}" "${name}" "${name}" "${name}" "${name}" "${name}" "${name}"
	if [ "${has_version}" -eq 0 ]; then
		err "警告: Zip に ${slug}/VERSION が入っていないので、サーバーで版を確かめる行を省きました. .distignore から VERSION を外すことを勧めます."
	fi
	if [ -z "${prev}" ]; then
		err "メモ: 同じスラッグの前のタグが無いので、退避先の名前は ${bak} にしました(初回のアップロードなら、旧版の退避は要りません)."
	fi
}

# --- 入口 ---------------------------------------------------------------------------------------

main() {
	# 起動したときの引数を取っておく(「main」と答えて切り替えたあと、同じ引数で起動し直すため).
	ORIG_ARGS=("$@")
	# 引数なしは使い方の誤り. 説明を標準エラーに出して終了する.
	if [ "$#" -eq 0 ]; then
		usage >&2
		exit "${EXIT_USAGE}"
	fi

	# 先に --help / --version だけを拾う(他の引数と並んでいても、これらが優先).
	local arg
	for arg in "$@"; do
		case "${arg}" in
			-h | --help)
				usage
				exit 0
				;;
			--version)
				print_version
				exit 0
				;;
		esac
	done

	# 残りの引数を解釈する. --dry-run と --rebuild は組み合わせられる(--rebuild --dry-run = 作り直しの確認だけ).
	# 位置引数は、1 つ目 = スラッグ・2 つ目 = 版(--rebuild のときだけ).
	local slug="" version="" want_list=0 dry=0 rebuild=0 allow_change=0 manifest=0 sign=0 yes=0 verify_content=0 json_file=""
	while [ "$#" -gt 0 ]; do
		case "$1" in
			--list) want_list=1 ;;
			--dry-run) dry=1 ;;
			--rebuild) rebuild=1 ;;
			--allow-content-change) allow_change=1 ;;
			--manifest) manifest=1 ;;
			--sign) sign=1 ;;
			--yes) yes=1 ;;
			--verify-content) verify_content=1 ;;
			--json)
				# 値は次の引数. 無い・空・オプションの形('-' で始まる)なら使い方の誤り.
				if [ "$#" -lt 2 ] || [ -z "$2" ] || [ "${2#-}" != "$2" ]; then
					err "${PROG}: --json にはレポートを作るパスを付けてください(例: --json report.json)."
					exit "${EXIT_USAGE}"
				fi
				# カレントからの相対パスは、ここで絶対パスにする(以後 cd しても変わらない).
				case "$2" in
					/*) json_file="$(normalize_path "$2")" ;;
					*) json_file="$(normalize_path "${PWD}/$2")" ;;
				esac
				shift
				;;
			-*)
				err "${PROG}: 不明なオプション '$1'"
				err "'${PROG} --help' で使い方を確認してください."
				exit "${EXIT_USAGE}"
				;;
			*)
				if [ -z "${slug}" ]; then
					slug="$1"
				elif [ -z "${version}" ]; then
					version="$1"
				else
					err "${PROG}: 余分な引数です('$1'). スラッグ(と --rebuild のときの版)だけを指定してください."
					exit "${EXIT_USAGE}"
				fi
				;;
		esac
		shift
	done

	# --list は、スラッグも他のオプションも取らない.
	if [ "${want_list}" -eq 1 ]; then
		if [ -n "${slug}" ] || [ "${dry}" -eq 1 ] || [ "${rebuild}" -eq 1 ] || [ "${allow_change}" -eq 1 ] || [ "${manifest}" -eq 1 ] || [ "${sign}" -eq 1 ] || [ "${yes}" -eq 1 ] || [ "${verify_content}" -eq 1 ] || [ -n "${json_file}" ]; then
			err "${PROG}: --list には、スラッグも他のオプションも付けられません."
			exit "${EXIT_USAGE}"
		fi
		cmd_list
		exit 0
	fi
	if [ -z "${slug}" ]; then
		err "${PROG}: スラッグを指定してください."
		err "'${PROG} --help' で使い方を確認してください."
		exit "${EXIT_USAGE}"
	fi
	# 版の指定は、作り直す版を決めるためのもの. 通常の実行では HEAD の版を使うので、受け付けない(打ち間違いを防ぐ).
	if [ -n "${version}" ] && [ "${rebuild}" -eq 0 ]; then
		err "${PROG}: 版を指定できるのは --rebuild のときだけです('${version}'). 通常の実行は、HEAD の版でタグを打ちます."
		exit "${EXIT_USAGE}"
	fi

	# 内容の不一致を許すのは、作り直し(--rebuild)の比較のときだけ. 通常の実行には、比べる記録がない.
	if [ "${allow_change}" -eq 1 ] && [ "${rebuild}" -eq 0 ]; then
		err "${PROG}: --allow-content-change は --rebuild のときだけ指定できます(作り直した Zip の内容の指紋が、タグの記録と違うときに続けるためのものです)."
		exit "${EXIT_USAGE}"
	fi

	# 署名するのは、タグを打つ通常の実行だけ. --rebuild はタグを打たない.
	if [ "${sign}" -eq 1 ] && [ "${rebuild}" -eq 1 ]; then
		err "${PROG}: --sign は、タグを打つ通常の実行でだけ指定できます(--rebuild はタグを打ちません)."
		exit "${EXIT_USAGE}"
	fi

	# --yes は、タグを打つ通常の実行の「main 以外のブランチからの確認」を飛ばすもの. --rebuild はブランチを確かめない(タグの時点から作る)ので、確認も無い.
	if [ "${yes}" -eq 1 ] && [ "${rebuild}" -eq 1 ]; then
		err "${PROG}: --yes は、タグを打つ通常の実行でだけ指定できます(--rebuild はタグの時点から作るので、ブランチの確認がありません)."
		exit "${EXIT_USAGE}"
	fi

	# --verify-content は、--dry-run の確認を、Zip を作るところまで広げるもの. --dry-run が無ければ、本番の実行が Zip を作るので意味がない.
	if [ "${verify_content}" -eq 1 ] && [ "${dry}" -eq 0 ]; then
		err "${PROG}: --verify-content は --dry-run と一緒にだけ指定できます(Zip を一時ディレクトリに作って中身まで確かめ、消すためのものです)."
		exit "${EXIT_USAGE}"
	fi

	# --json は、成功したあとのレポート. --dry-run は何も作らないので、一緒には使えない.
	if [ -n "${json_file}" ] && [ "${dry}" -eq 1 ]; then
		err "${PROG}: --json は --dry-run と一緒に使えません(--dry-run は何も作らないので、レポートに書く Zip がありません)."
		exit "${EXIT_USAGE}"
	fi

	cmd_build "${slug}" "${dry}" "${rebuild}" "${version}" "${allow_change}" "${manifest}" "${sign}" "${verify_content}" "${json_file}" "${yes}"
}

main "$@"
